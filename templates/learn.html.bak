<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="light">
{% include "partials/_head.html" %}
<body>

{% include "partials/_intro.html" %}

<!-- ═══ WATERMARK ══════════════════════════════════ -->
<svg id="wm" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <line x1="26" y1="149" x2="114" y2="149" stroke="currentColor" stroke-width="1.5"/>
  <line x1="26" y1="153" x2="114" y2="153" stroke="currentColor" stroke-width="1" opacity=".55"/>
  <line x1="27" y1="157" x2="113" y2="157" stroke="currentColor" stroke-width=".8" opacity=".35"/>
  <line x1="28" y1="160" x2="112" y2="160" stroke="currentColor" stroke-width=".6" opacity=".2"/>
  <line x1="9"  y1="8"   x2="9"   y2="149" stroke="currentColor" stroke-width="3"/>
  <line x1="16" y1="10"  x2="16"  y2="147" stroke="currentColor" stroke-width=".8" opacity=".28"/>
  <line x1="25" y1="8"   x2="25"  y2="149" stroke="currentColor" stroke-width="2"/>
  <rect x="9" y="6" width="106" height="143" rx="3" stroke="currentColor" stroke-width="2"/>
  <rect x="19" y="16" width="86" height="123" rx="1.5" stroke="currentColor" stroke-width="1"/>
  <path d="M19 30 C17 23 21 17 27 19" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
  <path d="M19 30 C13 26 14 18 21 16" stroke="currentColor" stroke-width=".9" stroke-linecap="round" opacity=".7"/>
  <path d="M19 30 C12 27 12 19 17 15" stroke="currentColor" stroke-width=".7" stroke-linecap="round" opacity=".45"/>
  <circle cx="19" cy="30" r="1.8" fill="currentColor" opacity=".55"/>
  <path d="M105 30 C107 23 103 17 97 19" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
  <path d="M105 30 C111 26 110 18 103 16" stroke="currentColor" stroke-width=".9" stroke-linecap="round" opacity=".7"/>
  <path d="M105 30 C112 27 112 19 107 15" stroke="currentColor" stroke-width=".7" stroke-linecap="round" opacity=".45"/>
  <circle cx="105" cy="30" r="1.8" fill="currentColor" opacity=".55"/>
  <path d="M19 125 C17 132 21 138 27 136" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
  <path d="M19 125 C13 129 14 137 21 139" stroke="currentColor" stroke-width=".9" stroke-linecap="round" opacity=".7"/>
  <path d="M19 125 C12 128 12 136 17 140" stroke="currentColor" stroke-width=".7" stroke-linecap="round" opacity=".45"/>
  <circle cx="19" cy="125" r="1.8" fill="currentColor" opacity=".55"/>
  <path d="M105 125 C107 132 103 138 97 136" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
  <path d="M105 125 C111 129 110 137 103 139" stroke="currentColor" stroke-width=".9" stroke-linecap="round" opacity=".7"/>
  <path d="M105 125 C112 128 112 136 107 140" stroke="currentColor" stroke-width=".7" stroke-linecap="round" opacity=".45"/>
  <circle cx="105" cy="125" r="1.8" fill="currentColor" opacity=".55"/>
</svg>

{% include "partials/_header.html" %}
{% include "partials/_ticker.html" %}

<main id="main">

  {% include "partials/_hero.html" %}

  <!-- ═══ STATEMENT BAR ═══════════════════════════════════════ -->
  <div class="statement-bar">
    <span class="sb-label" data-i18n="learn_sb_label">{{ t.learn_sb_label }}</span>
    <span class="sb-body" data-i18n="learn_sb_body">{{ t.learn_sb_body }}</span>
  </div>

  <!-- ─── LANGUAGE NOTICE (JS shows when non-EN) ────────────── -->
  <div id="learn-lang-notice" style="display:none;background:var(--gold-bg);border:1px solid var(--gold-border);border-radius:6px;
              padding:10px 18px;margin:12px 24px;font-size:12px;color:var(--gold);
              align-items:center;gap:8px">
    <span>🌐</span>
    <span data-i18n="learn_notice_en_only">{{ t.learn_notice_en_only }}</span>
  </div>
  <script>
  if(window.SAINHE_LANG&&window.SAINHE_LANG!=='en'){
    var n=document.getElementById('learn-lang-notice');
    if(n)n.style.display='flex';
  }
  </script>

  <!-- ─── 00 · WHY FINANCE ────────────────────────────────── -->
  <div class="sec-band sec-choc" id="learn-whyfinance">
    <div class="section-lbl">
      
      <h2>Why Finance</h2><em>Before anything else</em>
    </div>
    <div class="lrn-wrap">
      <div class="lrn-body" style="max-width:860px;margin:0 auto">

        <div class="lrn-panel-rows">

          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">The honest answer</div>
            <div class="lrn-panel-row-val">Most people never learn how money actually works. They earn it, spend it, and hope there's enough left at the end. Finance isn't about getting rich quick — it's about understanding the rules of the game so you can make <strong>deliberate decisions</strong> instead of default ones.</div>
          </div>

          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">The personal angle</div>
            <div class="lrn-panel-row-val">Every major life decision has a financial dimension: your first job, buying a flat, starting a company, retiring early. The people who navigate these well aren't necessarily smarter — they've just internalized a few core ideas early enough to let them <strong>compound</strong>.</div>
          </div>

          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">Where most people start</div>
            <div class="lrn-panel-row-val">Usually with the stock market. And that's fine — but markets are just one piece. The real foundation is understanding <strong>time, risk, and return</strong>. Once those click, everything else — indices, sectors, macroeconomics — becomes a natural extension.</div>
          </div>

        </div>

        <!-- ── Compound interest visualization ───────────── -->
        <div style="margin:2.4rem 0 2rem">

          <div style="margin-bottom:1.4rem">
            <div style="font-family:var(--serif);font-size:1.45rem;color:#F5E8D0;line-height:1.25;margin-bottom:.4rem">Compound interest, <em style="color:#C4955A">made legible.</em></div>
            <div style="color:rgba(245,232,208,.5);font-size:.85rem;letter-spacing:.01em">Your money earns interest — then that interest earns more.</div>
          </div>

          <div style="background:#1A0C05;border:1px solid rgba(196,149,90,.18);border-radius:16px;padding:1.6rem 1.8rem 1.2rem;box-shadow:0 24px 64px rgba(0,0,0,.45)">

            <!-- Legend -->
            <div style="display:flex;gap:1.6rem;margin-bottom:1.2rem;flex-wrap:wrap">
              <div style="display:flex;align-items:center;gap:.45rem">
                <div style="width:10px;height:10px;border-radius:2px;background:rgba(196,149,90,.72);flex-shrink:0"></div>
                <span style="color:rgba(245,232,208,.55);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase">Initial Investment</span>
              </div>
              <div style="display:flex;align-items:center;gap:.45rem">
                <div style="width:10px;height:10px;border-radius:2px;background:rgba(196,149,90,.36);flex-shrink:0"></div>
                <span style="color:rgba(245,232,208,.55);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase">Interest Earned</span>
              </div>
              <div style="display:flex;align-items:center;gap:.45rem">
                <div style="width:10px;height:10px;border-radius:2px;background:rgba(245,215,140,.28);flex-shrink:0"></div>
                <span style="color:rgba(245,232,208,.55);font-size:.7rem;letter-spacing:.06em;text-transform:uppercase">Interest on Interest</span>
              </div>
            </div>

            <svg viewBox="0 0 700 285" xmlns="http://www.w3.org/2000/svg" style="width:100%;display:block" aria-label="Compound interest stacked area chart — $10,000 at 8% over 30 years">

              <!-- Grid (horizontal) -->
              <line x1="70" y1="250" x2="650" y2="250" stroke="rgba(245,232,208,.14)" stroke-width="1"/>
              <line x1="70" y1="200" x2="650" y2="200" stroke="rgba(245,232,208,.05)" stroke-width="1" stroke-dasharray="3,6"/>
              <line x1="70" y1="155" x2="650" y2="155" stroke="rgba(245,232,208,.05)" stroke-width="1" stroke-dasharray="3,6"/>
              <line x1="70" y1="110" x2="650" y2="110" stroke="rgba(245,232,208,.05)" stroke-width="1" stroke-dasharray="3,6"/>
              <line x1="70" y1="65"  x2="650" y2="65"  stroke="rgba(245,232,208,.05)" stroke-width="1" stroke-dasharray="3,6"/>

              <!-- Y labels -->
              <text x="62" y="253" fill="rgba(245,232,208,.28)" font-size="9" text-anchor="end" font-family="monospace">$0</text>
              <text x="62" y="203" fill="rgba(245,232,208,.28)" font-size="9" text-anchor="end" font-family="monospace">$25k</text>
              <text x="62" y="158" fill="rgba(245,232,208,.28)" font-size="9" text-anchor="end" font-family="monospace">$50k</text>
              <text x="62" y="113" fill="rgba(245,232,208,.28)" font-size="9" text-anchor="end" font-family="monospace">$75k</text>
              <text x="62" y="68"  fill="rgba(245,232,208,.28)" font-size="9" text-anchor="end" font-family="monospace">$100k</text>

              <!-- Area 1 — Initial Investment ($10k, constant) -->
              <!-- y = 250 − (10000/105000)×235 ≈ 227 -->
              <path d="M70,227 L650,227 L650,250 L70,250 Z" fill="rgba(196,149,90,.60)"/>

              <!-- Area 2 — Interest Earned (simple: $800×t) -->
              <!-- tops: yr0=227 yr5=219 yr10=210 yr15=201 yr20=192 yr25=183 yr30=174 -->
              <path d="M70,227 L167,219 263,210 360,201 457,192 553,183 650,174 L650,227 L70,227 Z" fill="rgba(196,149,90,.32)"/>

              <!-- Area 3 — Interest on Interest (compound − initial − simple) -->
              <!-- top = compound curve; bottom = top of area 2 -->
              <path d="M70,227 C100,226 140,221 167,217 C200,214 235,207 263,202 C300,196 330,186 360,179 C395,171 425,156 457,146 C493,131 520,111 553,97 C585,80 620,48 650,25 L650,174 553,183 457,192 360,201 263,210 167,219 70,227 Z" fill="rgba(245,210,140,.19)"/>

              <!-- Compound curve — glow layer -->
              <path d="M70,227 C100,226 140,221 167,217 C200,214 235,207 263,202 C300,196 330,186 360,179 C395,171 425,156 457,146 C493,131 520,111 553,97 C585,80 620,48 650,25" fill="none" stroke="rgba(196,149,90,.18)" stroke-width="7" stroke-linecap="round"/>
              <!-- Compound curve — crisp line -->
              <path d="M70,227 C100,226 140,221 167,217 C200,214 235,207 263,202 C300,196 330,186 360,179 C395,171 425,156 457,146 C493,131 520,111 553,97 C585,80 620,48 650,25" fill="none" stroke="#C4955A" stroke-width="1.8" stroke-linecap="round"/>

              <!-- Stacked blocks at milestones (each block ≈ $10k) -->
              <!-- Year 10 (x=263, curve=202) → $21.6k ≈ 2 blocks -->
              <rect x="255" y="198" width="9" height="4" rx="1" fill="rgba(245,215,140,.45)"/>
              <rect x="255" y="203" width="9" height="4" rx="1" fill="rgba(196,149,90,.82)"/>

              <!-- Year 20 (x=457, curve=146) → $46.6k ≈ 5 blocks -->
              <rect x="449" y="142" width="9" height="4" rx="1" fill="rgba(245,215,140,.48)"/>
              <rect x="449" y="147" width="9" height="4" rx="1" fill="rgba(245,215,140,.55)"/>
              <rect x="449" y="152" width="9" height="4" rx="1" fill="rgba(196,149,90,.68)"/>
              <rect x="449" y="157" width="9" height="4" rx="1" fill="rgba(196,149,90,.80)"/>
              <rect x="449" y="162" width="9" height="4" rx="1" fill="rgba(196,149,90,.92)"/>

              <!-- Year 30 (x=650, curve=25) → $100.6k ≈ 10 blocks -->
              <rect x="642" y="19"  width="9" height="3.5" rx="1" fill="rgba(245,215,140,.42)"/>
              <rect x="642" y="23"  width="9" height="3.5" rx="1" fill="rgba(245,215,140,.48)"/>
              <rect x="642" y="27"  width="9" height="3.5" rx="1" fill="rgba(245,215,140,.54)"/>
              <rect x="642" y="31"  width="9" height="3.5" rx="1" fill="rgba(245,215,140,.60)"/>
              <rect x="642" y="35"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.64)"/>
              <rect x="642" y="39"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.70)"/>
              <rect x="642" y="43"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.76)"/>
              <rect x="642" y="47"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.82)"/>
              <rect x="642" y="51"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.88)"/>
              <rect x="642" y="55"  width="9" height="3.5" rx="1" fill="rgba(196,149,90,.96)"/>

              <!-- Milestone vertical guides -->
              <line x1="263" y1="202" x2="263" y2="250" stroke="rgba(245,232,208,.07)" stroke-width="1" stroke-dasharray="2,5"/>
              <line x1="457" y1="146" x2="457" y2="250" stroke="rgba(245,232,208,.07)" stroke-width="1" stroke-dasharray="2,5"/>

              <!-- Data point dots -->
              <circle cx="70"  cy="227" r="3"   fill="#C4955A" opacity=".65"/>
              <circle cx="263" cy="202" r="3.5" fill="#C4955A" opacity=".8"/>
              <circle cx="457" cy="146" r="4"   fill="#C4955A" opacity=".9"/>
              <circle cx="650" cy="25"  r="4.5" fill="#C4955A"/>

              <!-- Value callouts -->
              <rect x="222" y="185" width="40" height="13" rx="3" fill="rgba(26,12,5,.92)" stroke="rgba(196,149,90,.28)" stroke-width=".7"/>
              <text x="242" y="195" fill="rgba(245,232,208,.7)" font-size="8.5" text-anchor="middle" font-family="monospace">$21.6k</text>

              <rect x="415" y="129" width="40" height="13" rx="3" fill="rgba(26,12,5,.92)" stroke="rgba(196,149,90,.28)" stroke-width=".7"/>
              <text x="435" y="139" fill="rgba(245,232,208,.7)" font-size="8.5" text-anchor="middle" font-family="monospace">$46.6k</text>

              <rect x="571" y="9"  width="47" height="13" rx="3" fill="rgba(196,149,90,.22)" stroke="rgba(196,149,90,.48)" stroke-width=".8"/>
              <text x="594" y="19" fill="#C4955A" font-size="8.5" text-anchor="middle" font-family="monospace" font-weight="600">$100.6k</text>

              <!-- Acceleration annotation -->
              <text x="485" y="96"  fill="rgba(245,215,140,.5)" font-size="8.5" font-style="italic" text-anchor="middle">growth</text>
              <text x="485" y="107" fill="rgba(245,215,140,.5)" font-size="8.5" font-style="italic" text-anchor="middle">accelerates ↗</text>

              <!-- Timeline baseline -->
              <line x1="65"  y1="262" x2="652" y2="262" stroke="rgba(245,232,208,.09)" stroke-width="1"/>
              <polygon points="649,259 657,262 649,265" fill="rgba(245,232,208,.22)"/>

              <!-- Tick marks -->
              <line x1="70"  y1="259" x2="70"  y2="265" stroke="rgba(245,232,208,.35)" stroke-width="1.2"/>
              <line x1="263" y1="259" x2="263" y2="265" stroke="rgba(245,232,208,.35)" stroke-width="1.2"/>
              <line x1="457" y1="259" x2="457" y2="265" stroke="rgba(245,232,208,.35)" stroke-width="1.2"/>
              <line x1="650" y1="259" x2="650" y2="265" stroke="rgba(245,232,208,.35)" stroke-width="1.2"/>

              <!-- Timeline labels -->
              <text x="70"  y="277" fill="rgba(245,232,208,.38)" font-size="9.5" text-anchor="middle">Year 1</text>
              <text x="263" y="277" fill="rgba(245,232,208,.38)" font-size="9.5" text-anchor="middle">Year 10</text>
              <text x="457" y="277" fill="rgba(245,232,208,.38)" font-size="9.5" text-anchor="middle">Year 20</text>
              <text x="650" y="277" fill="rgba(245,232,208,.38)" font-size="9.5" text-anchor="middle">Year 30</text>

              <!-- Dashed connectors between timeline marks -->
              <line x1="92"  y1="262" x2="244" y2="262" stroke="rgba(245,232,208,.11)" stroke-width="1" stroke-dasharray="2,4"/>
              <line x1="284" y1="262" x2="438" y2="262" stroke="rgba(245,232,208,.11)" stroke-width="1" stroke-dasharray="2,4"/>
              <line x1="478" y1="262" x2="641" y2="262" stroke="rgba(245,232,208,.11)" stroke-width="1" stroke-dasharray="2,4"/>

            </svg>

            <!-- Footer strip -->
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.9rem;padding-top:.8rem;border-top:1px solid rgba(196,149,90,.1);flex-wrap:wrap;gap:.5rem">
              <span style="color:rgba(245,232,208,.32);font-size:.72rem;font-style:italic">$10,000 invested once at 8% per year</span>
              <span style="color:#C4955A;font-size:.76rem;font-weight:600;font-family:monospace">$100,627 after 30 years &rarr; ×10</span>
            </div>
          </div>

        </div>

        <!-- ── Three insight cards ────────────────────────── -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem;margin-bottom:1.8rem">

          <div style="background:rgba(196,149,90,.08);border:1px solid rgba(196,149,90,.2);border-radius:10px;padding:1.1rem 1.2rem">
            <div style="color:#C4955A;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">Time</div>
            <div style="color:rgba(245,232,208,.9);font-size:.88rem;line-height:1.55">Starting at 25 rather than 35 often means <strong style="color:#C4955A">doubling</strong> your final capital — at the exact same return rate.</div>
          </div>

          <div style="background:rgba(196,149,90,.08);border:1px solid rgba(196,149,90,.2);border-radius:10px;padding:1.1rem 1.2rem">
            <div style="color:#C4955A;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">Consistency</div>
            <div style="color:rgba(245,232,208,.9);font-size:.88rem;line-height:1.55">Investing $200/month regularly often outperforms a single lump sum — even a considerably larger one.</div>
          </div>

          <div style="background:rgba(196,149,90,.08);border:1px solid rgba(196,149,90,.2);border-radius:10px;padding:1.1rem 1.2rem">
            <div style="color:#C4955A;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem">Fees</div>
            <div style="color:rgba(245,232,208,.9);font-size:.88rem;line-height:1.55">A 1% annual fee looks negligible — over 30 years, it can silently consume <strong style="color:#C4955A">25%</strong> of your total wealth.</div>
          </div>

        </div>

        <div class="lrn-panel-rows">

          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">The rule of 72</div>
            <div class="lrn-panel-row-val">Divide 72 by your annual return rate to get the number of years it takes to double your money. At 6%/year → 12 years. At 10%/year → 7.2 years. It's a mental shortcut that makes abstract percentages feel <strong>real and tangible</strong>.</div>
          </div>

          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">So why SAINHE?</div>
            <div class="lrn-panel-row-val">SAINHE doesn't tell you what to buy. It gives you the context to make your own decisions: what's moving in the market, why sectors rotate, how macro conditions affect valuations. You bring the conviction — SAINHE brings the <strong>signal</strong>.</div>
          </div>

        </div>

      </div>
    </div>
  </div>

  <!-- ─── FINANCE MINDMAP — crème ────────────────────────── -->
  <div class="sec-band sec-creme" id="learn-mindmap">
    <div class="section-lbl">
      <h2>Finance Mindmap</h2><em>The full landscape, structured</em>
    </div>
    <div class="lrn-wrap">
      <div class="lrn-body" style="max-width:960px;margin:0 auto">

        <div class="lrn-panel-rows" style="margin-bottom:2rem">
          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">What does it do?</div>
            <div class="lrn-panel-row-val">This map organizes the entire field of finance into four interconnected branches — Capital Markets, Asset Management, Corporate Finance, and Quantitative Finance. Each branch contains the key concepts, formulas, and mental models practitioners use every day.</div>
          </div>
          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">Why is it relevant?</div>
            <div class="lrn-panel-row-val">Finance has no single entry point. Most people learn fragments — a bit of investing here, some accounting there — without seeing how the pieces connect. This map reveals the architecture of the discipline so you can navigate it deliberately, not by accident.</div>
          </div>
          <div class="lrn-panel-row">
            <div class="lrn-panel-row-lbl">How to use it?</div>
            <div class="lrn-panel-row-val">Select a branch to explore its nodes. <strong>Concepts</strong> are the building blocks, <strong>Formulas</strong> are the quantitative tools, and <strong>Notions</strong> are the mental models. Start with the branch most relevant to your goals — then trace the connections. Every branch borrows from the others.</div>
          </div>
        </div>

        <!-- ── Finance Mindmap — Force-Directed Graph ──── -->
        <div id="mm-wrap">

          <!-- Toolbar: zoom only -->
          <div id="mm-bar">
            <div id="mm-zoom-btns">
              <button onclick="mmZoom(1.35)" title="Zoom in">+</button>
              <button onclick="mmZoom(0.74)" title="Zoom out">−</button>
              <button onclick="mmFit()" title="Centre">⊟</button>
            </div>
          </div>

          <svg id="mm-svg"></svg>

          <div id="mm-legend">
            <div class="mm-li"><span class="mm-dot" style="width:14px;height:14px;background:#1A0800"></span>Root — Finance core (largest, deep gold)</div>
            <div class="mm-li"><span class="mm-dot" style="width:10px;height:10px;background:#5A3D1A"></span>CATEGORY — 4 pillars (topmost)</div>
            <div class="mm-li"><span class="mm-dot" style="background:#7B2D2D"></span>CONCEPT — caramel crimson</div>
            <div class="mm-li"><span class="mm-dot" style="background:#7A5C1A"></span>FORMULA — gold-warm brown</div>
            <div class="mm-li"><span class="mm-dot" style="background:#3D5C35"></span>NOTION — soft sage</div>
            <div class="mm-li mm-li-line"><span style="display:inline-block;width:24px;height:0;border-top:1px dashed rgba(90,60,30,.5);vertical-align:middle;margin-right:6px"></span>Connections from the Root plus a bit more</div>
          </div>

          <div id="mm-tip"></div>
        </div>

        <script src="https://d3js.org/d3.v7.min.js"></script>
        <script>
(function(){
"use strict";
const MMGRAPH = {"nodes":[{"id":"elem-7OQi9Ge1","label":"Liquidity","type":"Concept","category":"Capital Markets","desc":"Liquidity measures how quickly and cheaply an asset can be bought or sold without moving its price. Tight bid-ask spreads, deep order books and high volume signal high liquidity. Liquid assets command lower yields (a liquidity premium); illiquidity discounts can be large in stress. When liquidity vanishes — 2008, March","wiki":"https://en.wikipedia.org/wiki/Market_liquidity"},{"id":"elem-xfscazqV","label":"Triangular Arbitrage (Forex)","type":"Formula","category":"Arbitrage","desc":"Triangular arbitrage exploits inconsistent quotes across three FX pairs. Example: buy EUR/USD, sell EUR/GBP, buy GBP/USD — profit if cross rates misalign. Modern markets close these gaps in microseconds — opportunities now exist mainly for HFT firms. Foundational example of how arbitrage enforces consistent pricing. It","wiki":"https://en.wikipedia.org/wiki/Triangular_arbitrage"},{"id":"elem-ZtH4JIHh","label":"Cost of Carry","type":"Formula","category":"Commodities","desc":"Cost of carry sums all expenses of holding a position — financing, storage, insurance, less income. Drives the difference between spot and futures prices. Formula: F = S × e^((r + s - q)T), with r rate, s storage, q dividend or convenience yield. Negative carry positions bleed value over time; positive carry pays you t","wiki":"https://en.wikipedia.org/wiki/Cost_of_carry"},{"id":"elem-bs97ftCC","label":"Random Forest for credit scoring","type":"Notion","category":"Machine Learning","desc":"Random forests aggregate many decision trees to predict default probability and creditworthiness. Robust to outliers, non-linearities and missing data — practical for messy credit features. Widely used in fintech lending (Upstart, Affirm) alongside traditional scorecards. Less interpretable than logistic regression — e","wiki":"https://en.wikipedia.org/wiki/Random_forest"},{"id":"elem-gb198Jjy","label":"Leverage Ratio","type":"Formula","category":"Hedge Funds","desc":"Leverage ratio measures the fund's total exposure relative to its net asset value. Formula: Leverage = Total Notional Exposure / NAV. Hedge funds often run 2-10x leverage; banks run 10-30x. Higher leverage amplifies both returns and losses, creating tail risk. It is a core hedge fund risk metric watched by prime broker","wiki":"https://en.wikipedia.org/wiki/Leverage_(finance)"},{"id":"elem-cGetkC1q","label":"Board Independence Ratios","type":"Formula","category":"Corporate Governance","desc":"Board independence ratio is the share of directors with no material ties to management or major shareholders. Higher independence is associated with better oversight, less fraud risk and stronger governance ratings. Most exchanges require a majority of independent directors for listed firms. ISS, Glass Lewis and proxy ","wiki":"https://en.wikipedia.org/wiki/Independent_director"},{"id":"elem-unteIuf3","label":"Corporate Governance","type":"Concept","category":"Corporate Finance","desc":"Corporate governance is the system of rules, practices and processes by which a firm is directed and controlled. It balances power between shareholders, board, management and other stakeholders. Strong governance reduces agency costs, fraud risk and capital cost; weak governance produces Enron-style collapses. Boards, ","wiki":"https://en.wikipedia.org/wiki/Corporate_governance"},{"id":"elem-v2aEXB2T","label":"Project Finance","type":"Concept","category":"Corporate Finance","desc":"Project finance funds large infrastructure (power plants, pipelines, toll roads) using cash flows of the project itself. Lenders look only to project assets and revenues — recourse to the parent is limited or nonexistent. Special purpose vehicles, complex contracts and sponsor guarantees structure the deal. Used for tr","wiki":"https://en.wikipedia.org/wiki/Project_finance"},{"id":"elem-IRugKpsy","label":"Longevity Risk Modeling","type":"Notion","category":"Pension Funds","desc":"Longevity risk is the risk that retirees live longer than projected, increasing pension liabilities. Modeled using mortality tables, stochastic mortality models (Lee-Carter) and longevity bonds. Adds 0.5-1 year of life expectancy per decade — small numbers, huge balance-sheet impact. Solutions include longevity swaps, ","wiki":"https://en.wikipedia.org/wiki/Longevity_risk"},{"id":"elem-3Tjovyd3","label":"ESG & Sustainable Finance","type":"Concept","category":"Asset Management","desc":"ESG investing integrates environmental, social and governance criteria into investment decisions. Strategies include negative screening, best-in-class, thematic, impact and ESG integration. Over 30 trillion USD claims some ESG label; quality and standards remain hotly debated. Climate risk, regulatory pressure and shif","wiki":"https://en.wikipedia.org/wiki/Environmental,_social,_and_corporate_governance"},{"id":"elem-9rWqzsuW","label":"MOIC","type":"Formula","category":"Private Equity","desc":"Multiple on Invested Capital is a PE fund's gross return — total value returned divided by capital invested. Formula: MOIC = (Realized + Unrealized Value) / Invested Capital. Easy to interpret but ignores time — a 2x in 2 years differs vastly from 2x in 10. Top-quartile PE funds target 2.5-3x net MOIC. It is a core PE ","wiki":"https://en.wikipedia.org/wiki/Multiple_on_invested_capital"},{"id":"elem-ZtmyaSYE","label":"Gordon Growth Model","type":"Formula","category":"Dividend Policy","desc":"The Gordon Growth Model values a stock as the present value of perpetually growing dividends. Formula: P = D1 / (r - g), where D1 is next-year dividend, r is required return, g is growth. Sensitive to inputs — small changes in r or g swing valuations dramatically. Best suited for stable, mature dividend payers like uti","wiki":"https://en.wikipedia.org/wiki/Dividend_discount_model"},{"id":"elem-4dLWw5wR","label":"IRR","type":"Formula","category":"Project Finance","desc":"Internal Rate of Return is the discount rate that makes a project's NPV equal to zero. Compared to a hurdle rate (cost of capital) — accept if IRR exceeds hurdle. Easy to communicate but suffers from issues with non-conventional cash flows and reinvestment assumptions. MIRR (Modified IRR) addresses some of these limita","wiki":"https://en.wikipedia.org/wiki/Internal_rate_of_return"},{"id":"elem-Ekaoz0oW","label":"Modigliani-Miller Theorem","type":"Formula","category":"Capital Structure","desc":"Modigliani-Miller (1958) proved that under perfect markets, firm value is independent of capital structure. Adding taxes, distress costs and asymmetric information makes structure matter again. It is the theoretical anchor for every real-world capital structure argument. Won Modigliani and Miller Nobel Prizes and resha","wiki":"https://en.wikipedia.org/wiki/Modigliani%E2%80%93Miller_theorem"},{"id":"elem-hO0KYapB","label":"NPV (Net Present Value)","type":"Formula","category":"Capital Budgeting","desc":"Net Present Value sums all project cash flows discounted at the cost of capital. Formula: NPV = sum of CF_t / (1+r)^t, including initial investment as negative CF_0. Positive NPV means the project creates value; negative destroys it. NPV is the theoretically correct decision rule and dominates IRR when they conflict. I","wiki":"https://en.wikipedia.org/wiki/Net_present_value"},{"id":"elem-XEMruMM5","label":"Market Capitalization","type":"Formula","category":"Equity Market","desc":"Market cap is the total dollar value of a company's outstanding shares. Formula: Market Cap = Shares Outstanding × Price per Share. Defines size buckets — large cap (>10B), mid cap, small cap, micro cap. Used in index construction, ETF weighting and peer comparisons. It is the universal company-size metric and a determ","wiki":"https://en.wikipedia.org/wiki/Market_capitalization"},{"id":"elem-Cz9KXEgp","label":"Contango vs Backwardation","type":"Notion","category":"Commodities","desc":"Contango is when futures prices exceed spot — typical for storable commodities. Backwardation is when futures trade below spot — typical for shortages or convenience yield. Curve shape drives roll yields for ETFs and traders rolling forward contracts. Persistent contango (oil 2015-16) crushed many long-only commodity s","wiki":"https://en.wikipedia.org/wiki/Contango"},{"id":"elem-AQAF8YYX","label":"Market Microstructure","type":"Concept","category":"Capital Markets","desc":"Market microstructure studies how order flow, market design and trading rules shape prices and liquidity. Order books, matching engines, tick sizes and rebate structures all affect execution quality. It explains why large orders move prices, why spreads widen at the open and close, and how informed flow gets revealed. ","wiki":"https://en.wikipedia.org/wiki/Market_microstructure"},{"id":"elem-OVH9liSd","label":"Cash Conversion Cycle","type":"Formula","category":"Working Capital Management","desc":"The Cash Conversion Cycle measures the days between paying suppliers and collecting from customers. Formula: CCC = DIO + DSO - DPO (Days Inventory + Days Sales Outstanding - Days Payables). Shorter cycles free cash for growth; longer cycles tie up working capital. Amazon famously runs negative CCC — collecting before p","wiki":"https://en.wikipedia.org/wiki/Cash_conversion_cycle"},{"id":"elem-I8RAeCXe","label":"Dividend Policy","type":"Concept","category":"Corporate Finance","desc":"Dividend policy decides how much profit to distribute to shareholders versus reinvest in the business. Cash dividends, share buybacks and stock dividends are the three main payout tools. Stable, growing dividends signal management confidence; cuts are punished severely by markets. Tax treatment, signaling, agency costs","wiki":"https://en.wikipedia.org/wiki/Dividend_policy"},{"id":"elem-K3E5ONjq","label":"Agency Costs","type":"Notion","category":"Corporate Governance","desc":"Agency costs arise when managers (agents) act in their own interest rather than shareholders' (principals). Examples include excessive perks, empire building, risk aversion and short-termism. Mitigated through equity compensation, board oversight, debt discipline and active ownership. Jensen and Meckling's 1976 paper e","wiki":"https://en.wikipedia.org/wiki/Principal%E2%80%93agent_problem"},{"id":"elem-sAfXrvm2","label":"2/20 Fee Structure","type":"Formula","category":"Hedge Funds","desc":"The 2 and 20 fee structure charges a 2 percent annual management fee plus 20 percent of profits. Originated with hedge funds and venture capital, now compressing under fee pressure. Performance fee aligns manager and investor interests but biases toward risk-taking. High-water marks and hurdle rates moderate the upside","wiki":"https://en.wikipedia.org/wiki/Two_and_twenty"},{"id":"elem-ovothnRA","label":"IRR (PE)","type":"Formula","category":"Private Equity","desc":"Private equity IRR annualizes realized and projected fund cash flows to compute returns. Net IRR (after fees) is what LPs actually earn; gross IRR is the unmanipulated investment return. Top quartile PE funds target net IRRs of 15-25 percent over a fund life of about a decade. Sensitive to early distributions, leverage","wiki":"https://en.wikipedia.org/wiki/Internal_rate_of_return"},{"id":"elem-N1vPS4IR","label":"Stochastic Differential Equations (SDE)","type":"Formula","category":"Stochastic Calculus","desc":"SDEs model how variables evolve under both deterministic drift and random noise. General form: dX = μ(X,t) dt + σ(X,t) dW. Used across rates models, equity dynamics, credit and FX. Solved analytically when possible, or numerically via Euler-Maruyama and similar schemes. It is the universal modeling language of continuo","wiki":"https://en.wikipedia.org/wiki/Stochastic_differential_equation"},{"id":"elem-NfZggdbM","label":"DSO (Days Sales Outstanding)","type":"Formula","category":"Working Capital Management","desc":"DSO measures the average number of days a firm takes to collect receivables after a sale. Formula: DSO = (Accounts Receivable / Revenue) × Days in Period. Lower is better — faster collection means more cash, less credit risk. Industry benchmarks vary; trends matter more than absolute levels. It is a core working capita","wiki":"https://en.wikipedia.org/wiki/Days_sales_outstanding"},{"id":"elem-U9FC3B7i","label":"Vasicek Model","type":"Formula","category":"Yield Curve Modeling","desc":"Vasicek (1977) is a one-factor short-rate model with mean reversion. Formula: dr = a(b - r) dt + σ dW. Closed-form bond and option prices made it foundational. Allows negative rates — once a flaw, now realistic in some markets. It is one of the original short-rate models and a teaching staple in interest rate modeling.","wiki":"https://en.wikipedia.org/wiki/Vasicek_model"},{"id":"elem-HJo7OOTv","label":"Yield Curve Modeling","type":"Concept","category":"Quantitative Finance","desc":"Yield curve modeling describes how interest rates vary across maturities and evolve through time. Vasicek, CIR, Hull-White and Heath-Jarrow-Morton are flagship short-rate and curve models. They price bonds, swaps, swaptions, mortgage securities and any cash flow sensitive to rates. Curve shape (steep, flat, inverted) s","wiki":"https://en.wikipedia.org/wiki/Yield_curve"},{"id":"elem-HFXnZ6Cq","label":"Book Building process","type":"Notion","category":"IPO (Initial Public Offering)","desc":"Bookbuilding is the price discovery method where investment banks gather investor demand at varying prices. Final IPO price reflects aggregated indications of interest from institutional accounts. Replaced fixed-price offerings as the global standard since the 1990s. Allows price flexibility, gauges demand quality and ","wiki":"https://en.wikipedia.org/wiki/Book_building"},{"id":"elem-7tJCAkq7","label":"Law of Large Numbers","type":"Notion","category":"Monte Carlo Simulation","desc":"The Law of Large Numbers says sample averages converge to expected values as sample size grows. Justifies Monte Carlo: enough simulations and the average outcome converges to the truth. Convergence is at rate 1/sqrt(N) — accuracy doubles with 4x simulations. Foundational result in probability theory dating back to Bern","wiki":"https://en.wikipedia.org/wiki/Law_of_large_numbers"},{"id":"elem-S96s2t7V","label":"Profitability Index","type":"Formula","category":"Capital Budgeting","desc":"Profitability Index ranks projects by present value of future cash flows per dollar invested. Formula: PI = PV of Future Cash Flows / Initial Investment. PI > 1 means accept; useful for ranking under capital constraints. Combines NPV intuition with a per-dollar efficiency view. It is a practical tool when capital is sc","wiki":"https://en.wikipedia.org/wiki/Profitability_index"},{"id":"elem-3Gr5Be4r","label":"DSCR","type":"Formula","category":"Project Finance","desc":"Debt Service Coverage Ratio measures cash available to cover scheduled debt payments. Formula: DSCR = Cash Available for Debt Service / Debt Service. Above 1.0 means project covers debt; lenders typically require 1.2-1.5x in project finance. Tracked period by period through covenants in loan agreements. It is the centr","wiki":"https://en.wikipedia.org/wiki/Debt_service_coverage_ratio"},{"id":"elem-gpWaiPsg","label":"Programming (Python/C++)","type":"Concept","category":"Quantitative Finance","desc":"Modern quants write code daily — Python for research and prototyping, C++ for low-latency production systems. Pandas, NumPy, scikit-learn, PyTorch and QuantLib are the core data-stack libraries. Performance literacy (vectorization, cache lines, big-O complexity, GIL) separates good quants from great ones. Without code,","wiki":"https://en.wikipedia.org/wiki/Python_(programming_language)"},{"id":"elem-Hg6JNgp7","label":"Markowitz Efficient Frontier","type":"Notion","category":"Portfolio Theory","desc":"The efficient frontier is the set of portfolios offering the maximum expected return for each level of risk. Portfolios below the frontier are dominated and should never be held. Constructed from expected returns, variances and correlations of constituent assets. Markowitz won the Nobel for this 1952 framework — the co","wiki":"https://en.wikipedia.org/wiki/Efficient_frontier"},{"id":"elem-ifElI83j","label":"Carried Interest","type":"Notion","category":"Private Equity","desc":"Carried interest is the share of profits — typically 20 percent — that PE managers receive after returning capital to LPs. Subject to a hurdle rate (often 8 percent) before carry kicks in. Taxed as long-term capital gains in many jurisdictions, sparking ongoing political debate. Aligns GPs with fund performance and is ","wiki":"https://en.wikipedia.org/wiki/Carried_interest"},{"id":"elem-ytcld5Wa","label":"Delta: dC / dS","type":"Formula","category":"Derivatives","desc":"Delta is the option price's sensitivity to a small change in the underlying spot price. Formula: Delta = dC/dS, ranges 0 to 1 for calls and -1 to 0 for puts. Used to hedge: a Delta of 0.5 means 50 shares of underlying neutralize one option contract. Delta-hedging is the foundation of dynamic option replication. It is t","wiki":"https://en.wikipedia.org/wiki/Greeks_(finance)"},{"id":"elem-w5Yzn40O","label":"Vectorization (NumPy)","type":"Notion","category":"Programming (Python/C++)","desc":"Vectorization replaces Python loops with batched array operations using NumPy or pandas. Speedups of 10-1000x by leveraging compiled C code under the hood. Essential for backtesting strategies, computing risk metrics and ML preprocessing. Forces think-in-arrays — different mental model than imperative loops. It is a fo","wiki":"https://en.wikipedia.org/wiki/Array_programming"},{"id":"elem-B5qSPYrV","label":"Arbitrage","type":"Concept","category":"Quantitative Finance","desc":"Arbitrage exploits price discrepancies for the same risk across markets, locking in riskless profit. Pure arbitrage is rare and short-lived; statistical and risk arbitrage take controlled risk for higher returns. Triangular FX, ETF NAV gaps, merger spreads and convertible bonds are classic playgrounds. Arbitrageurs enf","wiki":"https://en.wikipedia.org/wiki/Arbitrage"},{"id":"elem-HB93mRbf","label":"Covenant Waiver","type":"Notion","category":"Debt Restructuring","desc":"A covenant waiver is a creditor's temporary relaxation of loan terms to avoid a technical default. Common when a borrower trips a financial covenant (leverage, coverage) but is otherwise solvent. Often comes with fees, higher rates or tighter future terms. Negotiated as an alternative to default acceleration, which ser","wiki":"https://en.wikipedia.org/wiki/Loan_covenant"},{"id":"elem-bjyZa6Yj","label":"Stress Testing","type":"Notion","category":"Risk Management (VaR)","desc":"Stress testing simulates extreme but plausible scenarios (1929, 2008, COVID) to assess portfolio resilience. Complements statistical risk metrics by capturing tail events not in historical data. Banks run mandatory stress tests under Fed CCAR, ECB and PRA frameworks. Reverse stress testing asks 'what scenarios would br","wiki":"https://en.wikipedia.org/wiki/Stress_test_(financial)"},{"id":"elem-PCps0Age","label":"VPIN","type":"Formula","category":"High-Frequency Trading (HFT)","desc":"Volume-Synchronized Probability of Informed Trading (VPIN) detects toxic order flow in real time. Spike in VPIN warned 30 minutes before the 2010 Flash Crash. Computed from volume buckets rather than time, making it scale-invariant. Used by exchanges and HFT firms to manage adverse selection and inventory risk. It is a","wiki":"https://en.wikipedia.org/wiki/VPIN"},{"id":"elem-Cwd14Vyn","label":"Stock Indices","type":"Concept","category":"Capital Markets","desc":"A stock index is a basket of stocks aggregated by a rule (market cap, price, equal weight) to track market segments. S&P 500, MSCI World, Nikkei and CAC 40 are headline benchmarks watched by trillions in passive money. Indices serve as performance yardsticks, underliers for ETFs and futures, and barometers of market se","wiki":"https://en.wikipedia.org/wiki/Stock_market_index"},{"id":"elem-8lItpWyE","label":"Law of One Price","type":"Notion","category":"Arbitrage Strategies","desc":"Law of One Price says identical assets in efficient markets must trade at identical prices. Cross-listed stocks, ETFs vs underlyings, ADRs vs locals all enforce this. Violations create arbitrage opportunities closed in seconds by traders. Underpins all no-arbitrage pricing — derivatives, FX forwards, futures. It is the","wiki":"https://en.wikipedia.org/wiki/Law_of_one_price"},{"id":"elem-yzEk31ah","label":"Bid-Ask Spread","type":"Formula","category":"Market Microstructure","desc":"The bid-ask spread is the difference between the highest bid and lowest ask in the order book. Formula: Spread = Ask - Bid. Narrower spreads signal liquidity; wider spreads signal risk, low volume or volatility. Market makers earn the spread as compensation for providing liquidity. It is the most direct microstructure ","wiki":"https://en.wikipedia.org/wiki/Bid%E2%80%93ask_spread"},{"id":"elem-lKiHeRSa","label":"Price Weighting","type":"Formula","category":"Stock Indices","desc":"Price weighting assigns index weights based on share price, not market cap. Dow Jones Industrial Average is the famous holdout using this method. A 200-dollar stock has twice the influence of a 100-dollar stock regardless of company size. Distortive and quirky — splits change weights without economic substance. It is m","wiki":"https://en.wikipedia.org/wiki/Price-weighted_index"},{"id":"elem-WxsY8Kmz","label":"Latency","type":"Notion","category":"High-Frequency Trading (HFT)","desc":"Latency is the time between sending an order and its confirmation by the exchange. HFT firms invest heavily in colocated servers, microwave networks and FPGAs to shave microseconds. Spread, Hibernia, Anova built dedicated transatlantic cables purely for latency advantage. Lower latency means first access to opportuniti","wiki":"https://en.wikipedia.org/wiki/Latency_(engineering)"},{"id":"elem-ZYReqiDW","label":"Tax Alpha","type":"Formula","category":"Wealth Management","desc":"Tax alpha is value added through tax-aware portfolio management — loss harvesting, asset location, lot selection. Studies estimate 0.5-1.5 percent annual alpha for sophisticated tax-aware portfolios. Compounded over decades, tax alpha rivals or exceeds investment alpha for tax-sensitive investors. Direct indexing and S","wiki":"https://en.wikipedia.org/wiki/Tax-loss_harvesting"},{"id":"elem-kdMtmnuI","label":"Covariance Matrix","type":"Formula","category":"Correlation Analysis","desc":"The covariance matrix captures variances and pairwise covariances of all assets in a portfolio. Symmetric, positive semi-definite — central object in portfolio optimization. Estimation noisy with many assets; shrinkage methods (Ledoit-Wolf) improve stability. Inputs to mean-variance optimization, risk parity and factor","wiki":"https://en.wikipedia.org/wiki/Covariance_matrix"},{"id":"elem-gewvfl4d","label":"Geometric Brownian Motion","type":"Formula","category":"Stochastic Calculus","desc":"Geometric Brownian Motion models stock prices with constant drift and volatility. Formula: dS = μS dt + σS dW. Foundation for Black-Scholes and most equity derivatives pricing. Implies log-normal price distribution and continuous paths — assumptions that miss jumps and fat tails. It is the canonical asset-price model i","wiki":"https://en.wikipedia.org/wiki/Geometric_Brownian_motion"},{"id":"elem-Uboc7mVr","label":"Funding Ratio","type":"Formula","category":"Pension Funds","desc":"Funding ratio is plan assets divided by the present value of pension liabilities. Above 100 percent means the plan can cover its obligations; below 100 percent it is underfunded. Sponsors must contribute extra cash to close large funding gaps over time. Discount rate assumptions hugely affect this ratio — small changes","wiki":"https://en.wikipedia.org/wiki/Pension"},{"id":"elem-4XkZI0sg","label":"Financial Econometrics","type":"Concept","category":"Quantitative Finance","desc":"Financial econometrics applies statistics to financial time series — returns, volatility, spreads, factors. Workhorse models include ARIMA for means, GARCH for volatility, VAR for systems and cointegration for long-run links. Used to test hypotheses, build forecasts, calibrate models and evaluate strategy performance. ","wiki":"https://en.wikipedia.org/wiki/Financial_econometrics"},{"id":"elem-SzkWwN16","label":"Enterprise Value","type":"Formula","category":"Business Valuation","desc":"Enterprise Value (EV) is the total value of a firm to all capital providers — debt and equity. Formula: EV = Market Cap + Total Debt - Cash & Equivalents + Minority Interest + Preferred. EV multiples (EV/EBITDA, EV/Sales) are capital-structure neutral, unlike P/E. Bankers use EV in M&A because the buyer takes on debt a","wiki":"https://en.wikipedia.org/wiki/Enterprise_value"},{"id":"elem-6Rwnbd7V","label":"Asset-Liability Matching (ALM)","type":"Notion","category":"Pension Funds","desc":"Asset-liability matching aligns the duration and characteristics of assets to liabilities. Used by pensions, insurers and banks to immunize against rate moves and timing mismatches. Long-duration liabilities are typically matched with long bonds and inflation-linked assets. Cashflow matching is the strictest form; dura","wiki":"https://en.wikipedia.org/wiki/Asset%E2%80%93liability_mismatch"},{"id":"elem-HhuIRX68","label":"Treynor Ratio","type":"Formula","category":"Alpha & Beta","desc":"Treynor ratio measures excess return per unit of systematic risk (beta). Formula: T = (R_p - R_f) / β_p. Useful for evaluating well-diversified portfolios where idiosyncratic risk is negligible. Complements Sharpe ratio when comparing portfolios with different beta exposures. It is a standard risk-adjusted performance ","wiki":"https://en.wikipedia.org/wiki/Treynor_ratio"},{"id":"elem-db5yrCwE","label":"No-Arbitrage Principle","type":"Notion","category":"Arbitrage Strategies","desc":"The no-arbitrage principle assumes that risk-free profit opportunities cannot exist in efficient markets. Used to derive pricing relationships — Black-Scholes, put-call parity, IRP. Stronger than equilibrium arguments — only requires that arbitrage be tradeable away. Foundational to all derivatives pricing and asset pr","wiki":"https://en.wikipedia.org/wiki/Arbitrage"},{"id":"elem-GyggfXAj","label":"REITs (Real Estate)","type":"Concept","category":"Asset Management","desc":"Real Estate Investment Trusts (REITs) are publicly listed companies that own and operate income-producing real estate. By law they distribute most of their taxable income as dividends, making them attractive yield vehicles. Sub-sectors include office, retail, industrial, residential, healthcare and data centers. REITs ","wiki":"https://en.wikipedia.org/wiki/Real_estate_investment_trust"},{"id":"elem-wf8cLsmF","label":"Normal Distribution: N(0,1)","type":"Formula","category":"Brownian Motion","desc":"The standard normal distribution N(0,1) has mean 0 and variance 1, with the famous bell curve shape. Foundation of statistics, hypothesis testing, confidence intervals and many financial models. Brownian increments, log-returns and central limit theorem outputs all converge to it. Real-world returns have fatter tails —","wiki":"https://en.wikipedia.org/wiki/Normal_distribution"},{"id":"elem-eA9Xz4l3","label":"Payback Period","type":"Formula","category":"Capital Budgeting","desc":"Payback period is the time required to recover the initial investment from project cash flows. Simple to compute and understand but ignores time value and post-payback cash flows. Discounted payback fixes the time-value flaw but still ignores tail value. Often used as a screen alongside NPV/IRR rather than a standalone","wiki":"https://en.wikipedia.org/wiki/Payback_period"},{"id":"elem-SFO4uRug","label":"ESG Integration","type":"Notion","category":"ESG & Sustainable Finance","desc":"ESG integration weaves environmental, social and governance considerations into investment analysis. Goes beyond exclusion — analysts factor ESG materiality into valuation and risk assessment. Best-practice integration is hard to distinguish from greenwashing without rigorous frameworks. PRI signatories pledge integrat","wiki":"https://en.wikipedia.org/wiki/Socially_responsible_investing"},{"id":"elem-sXaCKPy5","label":"Business Valuation","type":"Concept","category":"Corporate Finance","desc":"Business valuation estimates the economic value of a firm, division, project or asset. Three families of methods dominate: DCF (intrinsic), comparables (relative) and precedent transactions. Bankers, PE funds, courts and tax authorities all need defensible valuations daily. Small assumption changes can swing valuations","wiki":"https://en.wikipedia.org/wiki/Business_valuation"},{"id":"elem-qOZ26BG1","label":"Value at Risk (VaR)","type":"Formula","category":"Risk Management (VaR)","desc":"VaR estimates the maximum portfolio loss over a horizon at a given confidence (e.g. 99%). Computed via historical, parametric or Monte Carlo methods. Used by banks (Basel), funds and treasurers to size and limit risk-taking. Famously misses tail risk — the 2008 crisis losses far exceeded reported VaR limits. It is the ","wiki":"https://en.wikipedia.org/wiki/Value_at_risk"},{"id":"elem-O2SkhkMj","label":"Tracking Error","type":"Formula","category":"Passive Management (ETFs)","desc":"Tracking error measures how much a portfolio's returns deviate from its benchmark over time. Formula: TE = standard deviation of (Portfolio Return - Benchmark Return). Index funds aim for tracking error close to zero; active funds may run 4-8 percent. Also used in risk budgeting to allocate active risk across managers.","wiki":"https://en.wikipedia.org/wiki/Tracking_error"},{"id":"elem-cDgE9hLM","label":"Net Working Capital","type":"Formula","category":"Working Capital Management","desc":"Net working capital is current assets minus current liabilities — the short-term liquidity buffer. Formula: NWC = Current Assets - Current Liabilities. Positive NWC means the firm can cover near-term obligations; negative may signal stress or operational efficiency. Tracked closely in M&A as a normalization adjustment.","wiki":"https://en.wikipedia.org/wiki/Working_capital"},{"id":"elem-mdabgZpI","label":"Asset Management","type":"Category","category":"Finance","desc":"Asset management is the professional stewardship of pools of capital — pensions, endowments, mutual funds, private wealth. Managers build portfolios, balance risk and return, and try to beat or track benchmarks net of fees. The industry oversees over 100 trillion USD globally and decides where the world's savings get i","wiki":"https://en.wikipedia.org/wiki/Investment_management"},{"id":"elem-niR8KQpw","label":"Scaling Property: W_t ~ sqrt(t)","type":"Formula","category":"Brownian Motion","desc":"Brownian motion's standard deviation scales with the square root of time. Formula: σ(W_t) = √t. Why volatility annualization uses √(252) for daily and √(12) for monthly returns. Drives the time-decay structure of options and the term structure of risk. It is a foundational property of Brownian motion underlying most vo","wiki":"https://en.wikipedia.org/wiki/Wiener_process"},{"id":"elem-FHJgvIj2","label":"Stewardship Theory","type":"Notion","category":"Corporate Governance","desc":"Stewardship theory views managers as trustworthy stewards aligned with shareholders, not opportunistic agents. Contrasts with agency theory and emphasizes intrinsic motivation, identification and long-term horizons. Implies less monitoring, more empowerment and longer CEO tenure produces better outcomes. Empirically su","wiki":"https://en.wikipedia.org/wiki/Stewardship_theory"},{"id":"elem-vqvk59Bp","label":"Market-Cap Weighting","type":"Formula","category":"Stock Indices","desc":"Market-cap weighting sets each constituent's index weight proportional to its market capitalization. Formula: Weight_i = Cap_i / sum of Caps. Largest companies dominate — Apple alone is 7+ percent of S&P 500. Self-rebalancing — winners grow weight, losers shrink — minimizing turnover. It is the dominant index methodolo","wiki":"https://en.wikipedia.org/wiki/Capitalization-weighted_index"},{"id":"elem-JYR5JEMA","label":"Capital Markets","type":"Category","category":"Finance","desc":"Capital markets are the venues where stocks, bonds, currencies and derivatives are issued and traded. They match savers with users of capital, set prices that reflect collective expectations and channel trillions daily. Companies raise long-term funding here through IPOs and bond issues; investors transform savings int","wiki":"https://en.wikipedia.org/wiki/Capital_market"},{"id":"elem-nJPLbZhC","label":"Market Impact and Slippage","type":"Notion","category":"Market Microstructure","desc":"Market impact is the price move caused by your own order; slippage is the gap between expected and realized price. Both grow with order size, market volatility and liquidity scarcity. Estimated by impact models like Almgren-Chriss for optimal execution scheduling. Hidden costs that quietly erode performance for institu","wiki":"https://en.wikipedia.org/wiki/Market_impact"},{"id":"elem-qyjfI7Ql","label":"Stationarity and Unit Roots","type":"Notion","category":"Financial Econometrics","desc":"A stationary series has constant mean, variance and autocorrelation over time. Most financial price series are non-stationary (have unit roots); returns usually are stationary. Tested with ADF, KPSS and Phillips-Perron tests. Critical to test before regression — non-stationary series produce spurious results. It is a c","wiki":"https://en.wikipedia.org/wiki/Stationary_process"},{"id":"elem-g40XNJaL","label":"Machine Learning","type":"Concept","category":"Quantitative Finance","desc":"Machine learning fits flexible models to data to predict, classify or generate outputs. In finance it powers credit scoring, fraud detection, alpha generation, NLP on news, and execution. Random forests, gradient boosting, neural networks and reinforcement learning are workhorse techniques. Care is needed: financial da","wiki":"https://en.wikipedia.org/wiki/Machine_learning"},{"id":"elem-eL8NSwhC","label":"Commodities","type":"Concept","category":"Capital Markets","desc":"Commodities are raw materials traded globally — energy (oil, gas), metals (gold, copper), agriculture (wheat, soy), softs. Prices reflect supply, demand, weather, geopolitics and inventory dynamics through standardized futures contracts. Producers and consumers hedge price risk; financial players provide liquidity and ","wiki":"https://en.wikipedia.org/wiki/Commodity_market"},{"id":"elem-T4GWiT1o","label":"Minimum Variance Portfolio","type":"Formula","category":"Portfolio Theory","desc":"The minimum variance portfolio has the lowest possible volatility for a given asset universe. Found by minimizing portfolio variance subject to weight constraints. Anchors the left edge of the efficient frontier. Often outperforms cap-weighted indices over long horizons due to low-vol anomaly. It is a foundational cons","wiki":"https://en.wikipedia.org/wiki/Modern_portfolio_theory"},{"id":"elem-f7MY6sHQ","label":"Pearson Correlation","type":"Formula","category":"Correlation Analysis","desc":"Pearson correlation measures linear association between two variables. Formula: ρ = Cov(X,Y) / (σ_X × σ_Y), bounded [-1, 1]. Universal correlation metric, used throughout portfolio construction and risk modeling. Captures only linear dependence — misses nonlinear and tail relationships. It is the canonical correlation ","wiki":"https://en.wikipedia.org/wiki/Pearson_correlation_coefficient"},{"id":"elem-T0vlJkIJ","label":"NAV per share","type":"Formula","category":"REITs (Real Estate)","desc":"Net Asset Value per share is total fund or REIT assets minus liabilities, divided by shares outstanding. Mutual funds price at NAV daily; REITs and closed-end funds often trade at premium or discount to NAV. Formula: NAV/share = (Assets - Liabilities) / Shares Outstanding. Discount to NAV is a popular value strategy in","wiki":"https://en.wikipedia.org/wiki/Net_asset_value"},{"id":"elem-WuqYmq0o","label":"Debt Restructuring","type":"Concept","category":"Corporate Finance","desc":"Debt restructuring renegotiates the terms of existing debt when a borrower cannot meet original obligations. Tools include rate cuts, maturity extensions, principal haircuts, debt-for-equity swaps and covenant waivers. It is cheaper than bankruptcy for both sides — restructured firms keep operating, creditors recover m","wiki":"https://en.wikipedia.org/wiki/Debt_restructuring"},{"id":"elem-FsxWUqbk","label":"Alpha & Beta","type":"Concept","category":"Asset Management","desc":"Alpha measures excess return relative to a benchmark; beta measures sensitivity to market moves. An asset with beta 1.2 moves 20 percent more than the market; alpha is what skill (or luck) adds beyond. Together they decompose performance into market exposure (cheap) and active skill (expensive). Hedge funds market them","wiki":"https://en.wikipedia.org/wiki/Alpha_(finance)"},{"id":"elem-5Fk3thkn","label":"Stochastic Calculus","type":"Concept","category":"Quantitative Finance","desc":"Stochastic calculus extends standard calculus to random processes that evolve over continuous time. Ito's lemma, geometric Brownian motion and stochastic differential equations are its core tools. It is the mathematical language of derivatives pricing, risk modeling and continuous-time finance. Black-Scholes, interest-","wiki":"https://en.wikipedia.org/wiki/Stochastic_calculus"},{"id":"elem-3kN6WCJA","label":"IPO (Initial Public Offering)","type":"Concept","category":"Corporate Finance","desc":"An IPO is the first sale of a private company's shares to public investors, listing the stock on an exchange. It raises permanent capital for growth, gives early investors and employees liquidity, and creates a market valuation. Investment banks underwrite, price and market the offering through a multi-month process ca","wiki":"https://en.wikipedia.org/wiki/Initial_public_offering"},{"id":"elem-gqSl7rsY","label":"Central Limit Theorem","type":"Formula","category":"Monte Carlo Simulation","desc":"Central Limit Theorem says the average of independent samples approaches a normal distribution. Formula: (X̄ - μ) / (σ/√n) ~ N(0,1) as n grows large. Justifies normality assumptions throughout finance, from VaR to confidence intervals. Breaks down with heavy-tailed or strongly correlated data — beware tail-risk applica","wiki":"https://en.wikipedia.org/wiki/Central_limit_theorem"},{"id":"elem-0oLnKqjD","label":"Portfolio Theory","type":"Concept","category":"Asset Management","desc":"Modern portfolio theory (Markowitz, 1952) shows how to combine assets to maximize return for a given risk. Diversification works because correlations are imperfect — total risk is less than the sum of parts. The efficient frontier is the locus of portfolios offering the highest return per unit of variance. Won the Nobe","wiki":"https://en.wikipedia.org/wiki/Modern_portfolio_theory"},{"id":"elem-l3ayOhRi","label":"Forex (FX)","type":"Concept","category":"Capital Markets","desc":"Foreign exchange is the global market where currencies are traded against each other 24 hours a day. It is the largest financial market in the world, trading over 7 trillion USD per day. Spot, forwards, swaps and options are the main instruments; central banks, corporates and speculators are the main players. FX moves ","wiki":"https://en.wikipedia.org/wiki/Foreign_exchange_market"},{"id":"elem-WBDKAkva","label":"Working Capital Management","type":"Concept","category":"Corporate Finance","desc":"Working capital management oversees the firm's short-term assets and liabilities — cash, receivables, inventory, payables. The goal is to keep operations liquid without tying up too much cash in idle current assets. Stretch payables, collect receivables fast, hold lean inventory — that is the operational playbook. Even","wiki":"https://en.wikipedia.org/wiki/Working_capital"},{"id":"elem-5WzwucPc","label":"Greenshoe Option","type":"Notion","category":"IPO (Initial Public Offering)","desc":"A greenshoe (over-allotment option) lets underwriters sell up to 15 percent more shares than originally planned. If demand is strong, they exercise it; if weak, they buy shares to stabilize price. Named after Green Shoe Manufacturing, the first issuer to use it. It cushions IPO aftermarket performance and limits downsi","wiki":"https://en.wikipedia.org/wiki/Greenshoe"},{"id":"elem-Wk9wjiQB","label":"Neural Networks for time-series","type":"Notion","category":"Machine Learning","desc":"Neural networks (LSTM, Transformer, TCN) capture nonlinear patterns in financial time series. Used for return prediction, volatility forecasting and signal generation. Risk: overfitting, regime shifts and data leakage that destroy live performance. Best practitioners combine them with careful cross-validation and econo","wiki":"https://en.wikipedia.org/wiki/Recurrent_neural_network"},{"id":"elem-LQMraF5g","label":"Quantitative Finance","type":"Category","category":"Finance","desc":"Quantitative finance applies mathematics, statistics and code to price assets, model risk and design trading strategies. It blends stochastic calculus, machine learning and high-performance computing to find edge in noisy markets. Quants build the models that price options, manage VaR limits at banks and run systematic","wiki":"https://en.wikipedia.org/wiki/Mathematical_finance"},{"id":"elem-n5u1nLg4","label":"Sharpe Ratio","type":"Formula","category":"Portfolio Theory","desc":"Sharpe ratio measures excess return per unit of total risk (standard deviation). Formula: Sharpe = (R_p - R_f) / σ_p. Universal performance metric — Sharpe above 1 is considered solid, above 2 outstanding. Won Sharpe the Nobel Prize and remains the most-cited risk-adjusted return measure. It is the universal performanc","wiki":"https://en.wikipedia.org/wiki/Sharpe_ratio"},{"id":"elem-QCwCIefv","label":"Martingale Property","type":"Notion","category":"Brownian Motion","desc":"A martingale is a stochastic process whose expected future value equals its current value. Formula: E[X_(t+1) | F_t] = X_t. Underpins risk-neutral pricing — discounted prices are martingales under Q. Brownian motion and many financial models are martingales by construction. It is a fundamental concept in derivatives pr","wiki":"https://en.wikipedia.org/wiki/Martingale_(probability_theory)"},{"id":"elem-nW4eYSC6","label":"Carbon Intensity","type":"Formula","category":"ESG & Sustainable Finance","desc":"Carbon intensity measures CO2 emissions per unit of revenue or invested capital in a portfolio. Formula: Intensity = sum(Emissions × Weight) / sum(Revenue × Weight). Most-used decarbonization metric for portfolios pledging Paris alignment. Captures Scope 1, 2 and increasingly Scope 3 emissions. It is a flagship ESG mea","wiki":"https://en.wikipedia.org/wiki/Carbon_footprint"},{"id":"elem-KdSsKmA2","label":"Negative Screening","type":"Notion","category":"ESG & Sustainable Finance","desc":"Negative screening excludes specific sectors (tobacco, weapons, fossil fuels) from a portfolio. Oldest and simplest sustainable investing approach, dating back to religious endowments. Easy to implement but coarse — often misses better-positioned competitors within excluded sectors. Returns vary widely depending on whi","wiki":"https://en.wikipedia.org/wiki/Socially_responsible_investing"},{"id":"elem-2eRUMaAR","label":"Macaulay Duration","type":"Formula","category":"Fixed Income (Bond Market)","desc":"Macaulay duration is the weighted average time to receive a bond's cash flows, in years. Formula: D = sum of t × PV(CF_t) / Bond Price. Longer duration means greater sensitivity to interest rate changes. Modified duration approximates the percentage price change for a small yield move. It is the foundational interest r","wiki":"https://en.wikipedia.org/wiki/Bond_duration"},{"id":"elem-FZ1yrZh7","label":"Succession Planning","type":"Notion","category":"Wealth Management","desc":"Succession planning prepares the orderly transfer of wealth and businesses to next generations. Trusts, family offices, life insurance and gifting strategies are common tools. Multi-generational wealth often dissipates without disciplined succession structures. Combines legal, tax, estate and family governance consider","wiki":"https://en.wikipedia.org/wiki/Succession_planning"},{"id":"elem-Co4Z70HG","label":"Wealth Management","type":"Concept","category":"Asset Management","desc":"Wealth management provides integrated financial advice to high-net-worth individuals and families. Services span investment management, tax planning, estate structuring, philanthropy and concierge banking. Top firms (UBS, Morgan Stanley, JP Morgan Private Bank) manage trillions for the world's wealthy. Goal is multi-ge","wiki":"https://en.wikipedia.org/wiki/Wealth_management"},{"id":"elem-xvMSjYmM","label":"Debt-to-Equity Swap","type":"Notion","category":"Debt Restructuring","desc":"A debt-to-equity swap converts outstanding debt into ownership shares, deleveraging the firm. Used in restructurings when firms cannot service debt — creditors trade fixed claims for upside. Pre-existing equity is typically diluted heavily or wiped out completely. Common in chapter 11 emergences and major distressed de","wiki":"https://en.wikipedia.org/wiki/Debt-to-equity_swap"},{"id":"elem-3c2SX8Fy","label":"Brownian Motion","type":"Concept","category":"Quantitative Finance","desc":"Brownian motion is the continuous-time random process that models how prices wander unpredictably. Mathematically it has independent Gaussian increments scaling as the square root of time. It is the building block of geometric Brownian motion, the workhorse model for stock dynamics. Black-Scholes, Heston, jump-diffusio","wiki":"https://en.wikipedia.org/wiki/Brownian_motion"},{"id":"elem-g854ZyLD","label":"Systematic vs Idiosyncratic Risk","type":"Notion","category":"Alpha & Beta","desc":"Systematic risk affects all securities (recessions, rates, geopolitics) and cannot be diversified away. Idiosyncratic risk is firm-specific (CEO scandal, product launch) and disappears in large portfolios. CAPM rewards systematic risk via beta; idiosyncratic gets no reward in equilibrium. Diversification is the free lu","wiki":"https://en.wikipedia.org/wiki/Systematic_risk"},{"id":"elem-kzQmdnfo","label":"Amihud Illiquidity Ratio","type":"Formula","category":"Market Liquidity","desc":"Amihud (2002) measures price impact per dollar traded — how much price moves per unit volume. Formula: ILLIQ = average of |Return| / Volume. Higher values indicate less liquid markets where modest trades move prices a lot. Widely used in academic studies and as a real-world liquidity premium predictor. It is one of the","wiki":"https://en.wikipedia.org/wiki/Amihud_illiquidity_measure"},{"id":"elem-TCzMxDy2","label":"Derivatives","type":"Concept","category":"Capital Markets","desc":"Derivatives are contracts whose value derives from an underlying asset — stocks, rates, FX, commodities, credit. Options give the right to trade; futures and forwards lock in a price; swaps exchange cash-flow streams. Used for hedging (airlines hedge fuel), speculation, and arbitrage; notional volumes exceed 600 trilli","wiki":"https://en.wikipedia.org/wiki/Derivative_(finance)"},{"id":"elem-QhRflODD","label":"Correlation Analysis","type":"Concept","category":"Quantitative Finance","desc":"Correlation analysis measures how two variables move together — positive, negative or independent. In finance it drives diversification, hedging, factor models and pair trading strategies. Linear correlation hides nonlinear and tail dependence; copulas model joint behavior in extremes. Correlations are unstable — they ","wiki":"https://en.wikipedia.org/wiki/Correlation"},{"id":"elem-wI2G9YmP","label":"Synergy Value","type":"Formula","category":"M&A (Mergers & Acquisitions)","desc":"Synergy value is the additional value a combined entity should produce versus standalone operations. Cost synergies (overhead, procurement, footprint) are easier to quantify; revenue synergies are usually overstated. Common formula: Synergy = (V_AB) - (V_A + V_B). If acquirers pay too much premium, synergies must be en","wiki":"https://en.wikipedia.org/wiki/Synergy"},{"id":"elem-6izcf0KY","label":"Market Efficiency","type":"Concept","category":"Capital Markets","desc":"Market efficiency claims that asset prices fully reflect all available information at any point in time. Three forms — weak, semi-strong, strong — distinguish what kind of information is already priced in. If markets are efficient, beating them consistently is impossible without inside information or extra risk. Behavi","wiki":"https://en.wikipedia.org/wiki/Efficient-market_hypothesis"},{"id":"elem-CF5BrdoZ","label":"Passive Management (ETFs)","type":"Concept","category":"Asset Management","desc":"Passive management replicates an index rather than trying to beat it, charging minimal fees. Exchange-traded funds (ETFs) trade intraday like stocks and have grown to over 10 trillion USD globally. Vanguard, BlackRock and State Street dominate; their basis-point fees crushed active management economics. Critics warn pa","wiki":"https://en.wikipedia.org/wiki/Exchange-traded_fund"},{"id":"elem-DumlCZL9","label":"Cointegration","type":"Formula","category":"Financial Econometrics","desc":"Cointegration occurs when non-stationary series share a long-run equilibrium relationship. Formal test: residuals of regressing one on the other are stationary. Foundation of pairs trading and statistical arbitrage strategies. Granger and Engle won the Nobel for the cointegration framework. It is a foundational concept","wiki":"https://en.wikipedia.org/wiki/Cointegration"},{"id":"elem-Aei4qvE3","label":"Memory Management","type":"Notion","category":"Programming (Python/C++)","desc":"Memory management governs allocation, access and deallocation of memory in code. C++ requires manual control; Python uses garbage collection at performance cost. Cache locality, alignment and pre-allocation matter for low-latency systems. Memory leaks and fragmentation can crash long-running trading processes. It is a ","wiki":"https://en.wikipedia.org/wiki/Memory_management"},{"id":"elem-aoeVlZpJ","label":"Underpricing Formula","type":"Formula","category":"IPO (Initial Public Offering)","desc":"IPO underpricing is the first-day jump from offer price to closing price, often 10-20 percent on average. Underpricing % = (P_close - P_offer) / P_offer. Banks underprice intentionally to ensure successful placement and reward institutional clients. Founders and early investors see it as money left on the table; invest","wiki":"https://en.wikipedia.org/wiki/IPO_underpricing"},{"id":"elem-ZC7rydUV","label":"Debt Haircut","type":"Notion","category":"Debt Restructuring","desc":"A debt haircut is a reduction in principal value imposed on creditors during restructuring. Common in sovereign defaults (Greece 2012 imposed roughly 50 percent NPV haircuts) and corporate bankruptcies. Negotiated under threat of formal insolvency where recovery would be even lower. Holdouts and collective action claus","wiki":"https://en.wikipedia.org/wiki/Haircut_(finance)"},{"id":"elem-RT9qS8Jk","label":"VWAP","type":"Formula","category":"Market Microstructure","desc":"Volume-Weighted Average Price is the average trade price weighted by traded volume over a period. Formula: VWAP = sum(Price × Volume) / sum(Volume). Used as an execution benchmark — beating VWAP signals good execution. Algorithmic VWAP strategies break large orders into volume-aligned slices through the day. It is the ","wiki":"https://en.wikipedia.org/wiki/Volume-weighted_average_price"},{"id":"elem-HtoKqf4p","label":"Terminal Value Formula","type":"Formula","category":"Business Valuation","desc":"Terminal value captures all cash flows beyond the explicit DCF forecast period. Two main methods: Gordon Growth (TV = FCF × (1+g) / (r-g)) and Exit Multiple (TV = EBITDA × Multiple). Often represents 60-80 percent of total DCF value — making it the single biggest assumption. Sensitivity tables on g and exit multiples a","wiki":"https://en.wikipedia.org/wiki/Terminal_value_(finance)"},{"id":"elem-v3lPHpdW","label":"Asset Allocation","type":"Concept","category":"Asset Management","desc":"Asset allocation decides how a portfolio splits across asset classes — equities, bonds, cash, alternatives, real assets. Studies show it explains over 90 percent of long-term portfolio variance, far more than security selection. Strategic allocation sets the long-term anchor; tactical tilts adjust to market conditions;","wiki":"https://en.wikipedia.org/wiki/Asset_allocation"},{"id":"elem-Oo7SaJnk","label":"LLCR","type":"Formula","category":"Project Finance","desc":"Loan Life Coverage Ratio measures the present value of cash flows over the loan's remaining life relative to outstanding debt. Formula: LLCR = PV of CFADS over loan life / Outstanding Debt. Provides a forward-looking view of total repayment capacity, complementing period-by-period DSCR. Project finance lenders typicall","wiki":"https://en.wikipedia.org/wiki/Loan_life_coverage_ratio"},{"id":"elem-eJOblP25","label":"Variance Reduction techniques","type":"Notion","category":"Monte Carlo Simulation","desc":"Variance reduction techniques speed up Monte Carlo convergence without more simulations. Methods include antithetic variates, control variates, importance sampling and stratified sampling. A 10x variance reduction means equivalent accuracy with 10x fewer simulations. Critical for high-dimensional pricing and risk probl","wiki":"https://en.wikipedia.org/wiki/Variance_reduction"},{"id":"elem-cN0jqmeB","label":"FFO (Funds From Operations)","type":"Formula","category":"REITs (Real Estate)","desc":"FFO is the standard REIT cash-flow metric — net income plus depreciation and amortization, less gains on sales. Used because real estate depreciation under GAAP misrepresents economic performance. AFFO (Adjusted FFO) further refines for maintenance capex and other normalizations. Drives REIT valuation multiples (P/FFO)","wiki":"https://en.wikipedia.org/wiki/Funds_from_operations"},{"id":"elem-5lMZsV1u","label":"Creation/Redemption mechanism","type":"Notion","category":"Passive Management (ETFs)","desc":"ETFs use authorized participants who exchange baskets of underlying securities for ETF shares. This in-kind mechanism keeps ETF prices tightly aligned to NAV through arbitrage. Also makes ETFs more tax-efficient than mutual funds by avoiding capital gains distributions. Stress events (March 2020) tested the mechanism; ","wiki":"https://en.wikipedia.org/wiki/Exchange-traded_fund"},{"id":"elem-7F0y6HPR","label":"M&A (Mergers & Acquisitions)","type":"Concept","category":"Corporate Finance","desc":"Mergers and acquisitions are transactions where companies combine, one buys another, or a unit is spun off. Buyers seek synergies — cost cuts, revenue uplift, market power, tax benefits — that justify a control premium. Most M&A actually destroys value: integration is hard, synergies are over-promised and culture clash","wiki":"https://en.wikipedia.org/wiki/Mergers_and_acquisitions"},{"id":"elem-FgZlOSZJ","label":"Jensen's Alpha","type":"Formula","category":"Alpha & Beta","desc":"Jensen's Alpha measures portfolio excess return relative to CAPM-predicted return. Formula: α = R_p - [R_f + β(R_m - R_f)]. Positive alpha implies skill or risk factors not captured by beta; negative implies underperformance. Foundational metric in mutual fund and hedge fund evaluation. It is one of the most-used activ","wiki":"https://en.wikipedia.org/wiki/Jensen%27s_alpha"},{"id":"elem-6YHO5p1p","label":"Purchasing Power Parity (PPP)","type":"Notion","category":"Forex (FX)","desc":"PPP says exchange rates should adjust so identical baskets of goods cost the same in any currency. Absolute PPP is rarely seen; relative PPP says exchange rates change with inflation differentials. Big Mac Index is a famous practical illustration. Holds in the long run but deviates substantially short term — currencies","wiki":"https://en.wikipedia.org/wiki/Purchasing_power_parity"},{"id":"elem-3wAPefFF","label":"Pension Funds","type":"Concept","category":"Asset Management","desc":"Pension funds invest contributions today to pay retirement benefits over decades. Defined benefit plans promise a fixed payout; defined contribution plans (401(k), IRA) shift risk to the employee. They are the world's largest pool of long-term capital, holding tens of trillions of dollars. Asset-liability matching, lon","wiki":"https://en.wikipedia.org/wiki/Pension_fund"},{"id":"elem-XXgNjBKF","label":"Convexity","type":"Formula","category":"Fixed Income (Bond Market)","desc":"Convexity measures the curvature of the bond price-yield relationship — the second derivative. Captures what duration misses: prices fall less than duration predicts when yields rise. Higher convexity is desirable — more upside on falling yields, less downside on rising. Combined with duration in the formula: ΔP ≈ -Dur","wiki":"https://en.wikipedia.org/wiki/Bond_convexity"},{"id":"elem-aC1zyduC","label":"High Water Mark","type":"Notion","category":"Hedge Funds","desc":"A high water mark is the highest NAV a fund has ever reached for performance fee calculation. Manager only earns performance fees on returns above the high water mark. Protects investors from paying twice for the same gains after a drawdown. Standard in hedge funds and increasingly common in alternative vehicles. It is","wiki":"https://en.wikipedia.org/wiki/High-water_mark_(finance)"},{"id":"elem-HAy8YAhG","label":"Accretion/Dilution Analysis","type":"Notion","category":"M&A (Mergers & Acquisitions)","desc":"Accretion/dilution analysis measures whether an acquisition will increase or decrease the acquirer's EPS. Accretive deals lift EPS year one; dilutive deals reduce it, at least initially. Cash deals are usually accretive if the target's earnings yield exceeds the after-tax cost of debt. Stock deals depend on the relativ","wiki":"https://en.wikipedia.org/wiki/Accretion/dilution_analysis"},{"id":"elem-XeWN0mA5","label":"Interest Rate Parity","type":"Formula","category":"Forex (FX)","desc":"Interest Rate Parity links spot rates, forward rates and interest rate differentials between two currencies. Formula: F/S = (1 + i_d) / (1 + i_f). Eliminates risk-free arbitrage between borrowing in one currency and lending in another. Covered IRP holds tightly; uncovered IRP (carry trade) often violates in practice. I","wiki":"https://en.wikipedia.org/wiki/Interest_rate_parity"},{"id":"elem-7CBOgnoZ","label":"Reinforcement Learning for execution","type":"Notion","category":"Machine Learning","desc":"Reinforcement learning agents learn optimal trading actions through repeated simulated interaction. Used in execution algorithms (optimal liquidation), market making and dynamic hedging. Can outperform hand-coded heuristics by adapting to market microstructure. Sensitive to reward design and simulation realism — sim-to","wiki":"https://en.wikipedia.org/wiki/Reinforcement_learning"},{"id":"elem-Rp4DZrw9","label":"High-Frequency Trading (HFT)","type":"Concept","category":"Capital Markets","desc":"High-frequency trading uses ultra-low-latency systems to execute thousands of trades per second on small price discrepancies. Strategies include market making, statistical arbitrage, latency arbitrage and short-term momentum capture. HFT now accounts for over half of US equity volume and tightens spreads but raises sta","wiki":"https://en.wikipedia.org/wiki/High-frequency_trading"},{"id":"elem-RDzv8Gz5","label":"Finance","type":"Root","category":"","desc":"Finance is the discipline that studies how individuals, firms and states allocate scarce capital across time and risk. It splits the economy into savers and borrowers and prices the bridge between them through interest rates, returns and contracts. Every modern economy depends on finance to channel money toward product","wiki":"https://en.wikipedia.org/wiki/Finance"},{"id":"elem-XQm37kzs","label":"Capital Budgeting","type":"Concept","category":"Corporate Finance","desc":"Capital budgeting is the process of evaluating and selecting long-term investment projects. Standard tools are NPV, IRR, payback period and the profitability index, all built on discounted cash flows. It allocates billions to the projects that will define the firm's competitive position for a decade. Bad capital alloca","wiki":"https://en.wikipedia.org/wiki/Capital_budgeting"},{"id":"elem-bcvAONXx","label":"Monte Carlo Simulation","type":"Concept","category":"Quantitative Finance","desc":"Monte Carlo simulation estimates outcomes by running thousands of random scenarios through a model. It prices exotic derivatives, stresses portfolio risk, models retirement outcomes and runs credit simulations. Easy to implement, embarrassingly parallel and applicable when closed-form solutions do not exist. Variance r","wiki":"https://en.wikipedia.org/wiki/Monte_Carlo_method"},{"id":"elem-6qIxom1X","label":"DCF Formula","type":"Formula","category":"Business Valuation","desc":"Discounted Cash Flow values an asset as the present value of its expected future free cash flows. Formula: V = sum of FCF_t / (1+r)^t plus a terminal value. Inputs include cash flow forecasts, discount rate (WACC) and growth assumptions. DCF is theoretically pure but garbage-in-garbage-out: small assumption changes swi","wiki":"https://en.wikipedia.org/wiki/Discounted_cash_flow"},{"id":"elem-3PuEdNCf","label":"Depth of Book","type":"Notion","category":"Liquidity","desc":"Depth of book is the cumulative order quantity available at various price levels in the order book. Deeper books absorb large orders with minimal price impact. Tracked by traders as a real-time liquidity gauge before sending sizable orders. Ephemeral depth (quotes flicker in and out) overstates true liquidity. It is a ","wiki":"https://en.wikipedia.org/wiki/Order_book_(trading)"},{"id":"elem-xzqPZ0wX","label":"Laspeyres Index formula","type":"Formula","category":"Stock Indices","desc":"Laspeyres uses base-period quantities to weight current prices when computing aggregate price changes. Formula: I_L = sum(P_t × Q_0) / sum(P_0 × Q_0). Used in inflation indices like CPI and many traditional stock indices. Tends to overstate inflation because it ignores substitution toward cheaper goods. It is a foundat","wiki":"https://en.wikipedia.org/wiki/Laspeyres_index"},{"id":"elem-c7KUwGyl","label":"Expense Ratio","type":"Formula","category":"Passive Management (ETFs)","desc":"Expense ratio is the annual fee a fund charges as a percent of assets. ETF leaders charge 0.03-0.10 percent; active mutual funds typically 0.5-1.5 percent. Compounded over decades, even small differences mean tens of thousands per investor. Single best predictor of long-run mutual fund performance per Morningstar studi","wiki":"https://en.wikipedia.org/wiki/Expense_ratio"},{"id":"elem-9gxtstWR","label":"Turnover Ratio","type":"Formula","category":"Market Liquidity","desc":"Turnover ratio measures trading activity relative to market size or fund holdings. Formula: Turnover = Volume Traded / Shares Outstanding (for stocks). Higher turnover signals higher liquidity and active rebalancing. For funds, high turnover implies high transaction costs and tax inefficiency. It is a standard liquidit","wiki":"https://en.wikipedia.org/wiki/Turnover_(finance)"},{"id":"elem-aXZA42mU","label":"Put-Call Parity","type":"Formula","category":"Derivatives","desc":"Put-call parity is a no-arbitrage relationship between European call and put prices on the same underlying. Formula: C - P = S - K × e^(-rT). Violations create arbitrage opportunities that traders close almost instantly. Used to derive synthetic positions and check option pricing consistency. It is one of the most fund","wiki":"https://en.wikipedia.org/wiki/Put%E2%80%93call_parity"},{"id":"elem-Lt6t4zt6","label":"Copulas (Tail Dependence)","type":"Formula","category":"Correlation Analysis","desc":"Copulas model joint distributions while separating marginal behavior from dependence structure. Used in credit risk to capture tail dependence Pearson correlation misses. Gaussian copulas underpriced subprime risk in 2008 — a famous failure of the technique. More flexible families (Clayton, Gumbel, Student-t) capture a","wiki":"https://en.wikipedia.org/wiki/Copula_(probability_theory)"},{"id":"elem-ew8aeGCg","label":"Dividend Yield","type":"Formula","category":"Dividend Policy","desc":"Dividend yield is the annual dividend per share divided by the share price, expressed as a percentage. Formula: Yield = Annual Dividend per Share / Price per Share. High yield can signal value or trouble — sustainability matters more than headline rate. Comparable to bond yields when assessing income-focused investment","wiki":"https://en.wikipedia.org/wiki/Dividend_yield"},{"id":"elem-aXMMP417","label":"Convenience Yield","type":"Formula","category":"Commodities","desc":"Convenience yield is the implicit benefit of holding the physical commodity rather than a futures contract. Formula: F = S × e^((r + c - y)T), where y is convenience yield. Captures value of avoiding stockouts, supplying production processes or arbitraging shortages. Drives backwardation and explains why oil futures of","wiki":"https://en.wikipedia.org/wiki/Convenience_yield"},{"id":"elem-wyrXZKOL","label":"Private Equity","type":"Concept","category":"Asset Management","desc":"Private equity invests in companies that are not publicly traded, typically taking control with leveraged buyouts. PE funds source deals, improve operations, restructure capital and exit through sales or IPOs after 5-7 years. Returns target 20 percent IRR or more and have outperformed public equity over many cycles, pa","wiki":"https://en.wikipedia.org/wiki/Private_equity"},{"id":"elem-rLKw7Hbz","label":"Bond Pricing Formula","type":"Formula","category":"Fixed Income (Bond Market)","desc":"A bond's price is the present value of all coupon payments plus principal repayment. Formula: P = sum of C / (1+y)^t + F / (1+y)^n. Yield to maturity (y) is the discount rate that equates price to discounted cash flows. When yields rise, prices fall — the central inverse relationship in fixed income. It is the bedrock ","wiki":"https://en.wikipedia.org/wiki/Bond_valuation"},{"id":"elem-MYTNQty7","label":"Strategic Asset Allocation (SAA)","type":"Notion","category":"Asset Allocation","desc":"Strategic asset allocation sets long-term target weights across asset classes based on risk and return objectives. Anchored in the investor's horizon, liabilities and risk tolerance. Reviewed every 3-5 years; tactical tilts adjust around it. Drives the bulk of long-run portfolio performance per Brinson studies. It is t","wiki":"https://en.wikipedia.org/wiki/Asset_allocation"},{"id":"elem-SH588GBT","label":"D/E Ratio","type":"Formula","category":"Capital Structure","desc":"The Debt-to-Equity ratio compares total liabilities to shareholders' equity, a key leverage gauge. Formula: D/E = Total Debt / Total Equity. Higher D/E means more leverage — magnified returns but higher bankruptcy risk. Industry norms vary widely: utilities run high, software runs low. It is the headline number credito","wiki":"https://en.wikipedia.org/wiki/Debt-to-equity_ratio"},{"id":"elem-4ew6h9aB","label":"Cox-Ingersoll-Ross (CIR) process","type":"Formula","category":"Yield Curve Modeling","desc":"CIR (1985) is a short-rate model with mean reversion and rates that stay non-negative. Formula: dr = a(b - r) dt + σ √r dW. Variance scales with r, preventing negative rates under typical parameters. Used in bond pricing, derivatives and credit modeling. It is a workhorse interest rate model widely used in fixed income","wiki":"https://en.wikipedia.org/wiki/Cox%E2%80%93Ingersoll%E2%80%93Ross_model"},{"id":"elem-db5OFtCc","label":"Dividend Discount Model (DDM)","type":"Formula","category":"Equity Market","desc":"DDM values a stock as the present value of its expected future dividends. Formula: P = sum of D_t / (1+r)^t. Gordon Growth is the simplest variant; multi-stage DDMs handle changing growth phases. Best for mature dividend payers; useless for non-payers like growth tech. It is one of the oldest equity valuation models an","wiki":"https://en.wikipedia.org/wiki/Dividend_discount_model"},{"id":"elem-KwZQKutm","label":"Risk Parity","type":"Formula","category":"Asset Allocation","desc":"Risk parity allocates so each asset class contributes equally to total portfolio risk, not equal capital. Bonds get leveraged up; equities get scaled down — opposite of typical 60/40. Bridgewater's All Weather popularized the approach; many followed (AQR, Invesco). Underperforms in rising-rate regimes when leveraged bo","wiki":"https://en.wikipedia.org/wiki/Risk_parity"},{"id":"elem-ZriX6cyt","label":"Equity Market","type":"Concept","category":"Capital Markets","desc":"The equity market is where ownership shares of companies are issued, priced and traded. It includes primary issuance (IPOs, follow-ons) and the much larger secondary market on exchanges like NYSE and Nasdaq. Stocks have unlimited upside but residual claim — they pay only after debt holders and have first loss in bankru","wiki":"https://en.wikipedia.org/wiki/Stock_market"},{"id":"elem-5OxINPqg","label":"P/E Multiples","type":"Formula","category":"M&A (Mergers & Acquisitions)","desc":"Price to Earnings multiple is the most-cited relative valuation metric in equity markets. Formula: P/E = Price per Share / Earnings per Share. Compares to peers, history and growth rates to flag cheap or expensive stocks. Forward P/E uses expected earnings; trailing P/E uses reported. It is the universal valuation shor","wiki":"https://en.wikipedia.org/wiki/Price%E2%80%93earnings_ratio"},{"id":"elem-ANFOQCIc","label":"Interest Coverage","type":"Formula","category":"Capital Structure","desc":"Interest coverage ratio measures how easily a firm can pay interest on outstanding debt. Formula: EBIT / Interest Expense. Below 1.5x is a warning sign; above 4x is comfortable for most industries. Used by banks in covenants and by rating agencies to assess credit risk. It is one of the most-watched solvency ratios in ","wiki":"https://en.wikipedia.org/wiki/Times_interest_earned"},{"id":"elem-wGHMgy8R","label":"Carry Trade strategies","type":"Notion","category":"Forex (FX)","desc":"Carry trade borrows in low-yielding currency to invest in high-yielding currency, capturing the rate spread. Profits when funding currency stays weak; loses big when it appreciates suddenly. Yen carry trade was a multi-trillion dollar strategy unwound dramatically in 2008 and 2024. Profits long-term contradict uncovere","wiki":"https://en.wikipedia.org/wiki/Carry_(investment)"},{"id":"elem-yQqThEU3","label":"Hedge Funds","type":"Concept","category":"Asset Management","desc":"Hedge funds are private investment vehicles using leverage, derivatives and short selling to seek absolute returns. Strategies include long/short equity, global macro, event-driven, relative value and managed futures. They charge famously high fees (the classic 2 and 20) and serve qualified, wealthy investors. Best-kno","wiki":"https://en.wikipedia.org/wiki/Hedge_fund"},{"id":"elem-VHvr34wX","label":"Expected Shortfall (CVaR)","type":"Formula","category":"Risk Management (VaR)","desc":"Expected Shortfall (CVaR) is the average loss in scenarios worse than the VaR threshold. Formula: ES = E[Loss | Loss > VaR]. Captures tail behavior VaR ignores and is sub-additive (good mathematical properties). Adopted as the primary market risk metric in Basel III FRTB regulations. It is the modern successor to VaR f","wiki":"https://en.wikipedia.org/wiki/Expected_shortfall"},{"id":"elem-nN84scKt","label":"Time Complexity (Big O)","type":"Formula","category":"Programming (Python/C++)","desc":"Big O notation describes how algorithm runtime scales with input size — O(n), O(log n), O(n²) etc. Critical in low-latency trading where microseconds matter and large data sets are routine. An O(n²) algorithm on millions of ticks may run for hours; O(n log n) finishes in seconds. Foundation of computer science and a da","wiki":"https://en.wikipedia.org/wiki/Big_O_notation"},{"id":"elem-NYV4iY5N","label":"Cap Rate","type":"Formula","category":"REITs (Real Estate)","desc":"Capitalization rate measures real estate income yield — net operating income divided by property value. Formula: Cap Rate = NOI / Property Value. Lower cap rates indicate higher prices (or compressed yields), often signaling competitive markets. Used to value income-producing real estate and compare opportunities acros","wiki":"https://en.wikipedia.org/wiki/Capitalization_rate"},{"id":"elem-armErJ3f","label":"Capital Structure","type":"Concept","category":"Corporate Finance","desc":"Capital structure is the firm's mix of debt and equity financing on its balance sheet. Debt is cheaper after tax but adds bankruptcy risk; equity is flexible but expensive and dilutes owners. The right mix minimizes the weighted average cost of capital (WACC) and maximizes firm value. Modigliani-Miller showed that unde","wiki":"https://en.wikipedia.org/wiki/Capital_structure"},{"id":"elem-05MLrCA6","label":"Beta Formula","type":"Formula","category":"Equity Market","desc":"Beta measures a stock's sensitivity to market returns — the slope from a regression versus an index. Formula: Beta = Cov(R_i, R_m) / Var(R_m). Beta of 1 moves with the market; >1 amplifies, <1 dampens; negative is rare. Used in CAPM to compute required equity return and in risk decomposition. It is the canonical measur","wiki":"https://en.wikipedia.org/wiki/Beta_(finance)"},{"id":"elem-TRgA3VHu","label":"Corporate Finance","type":"Category","category":"Finance","desc":"Corporate finance studies how firms raise, allocate and return capital to maximize shareholder value. It covers investment decisions (which projects to fund), financing decisions (debt vs equity) and payout policy (dividends, buybacks). CFOs use it daily to set the cost of capital, structure deals and approve capex bud","wiki":"https://en.wikipedia.org/wiki/Corporate_finance"},{"id":"elem-oKCWJnFL","label":"Nelson-Siegel Model","type":"Formula","category":"Yield Curve Modeling","desc":"Nelson-Siegel parameterizes the yield curve with three factors: level, slope and curvature. Smooth, parsimonious and popular with central banks for fitting curves. Captures most curve shapes with just 4 parameters. Svensson extension adds a fourth factor for richer humps. It is a standard yield curve model used across ","wiki":"https://en.wikipedia.org/wiki/Fixed-income_attribution#Modeling_the_yield_curve"},{"id":"elem-EzY2Zvc4","label":"Fixed Income","type":"Concept","category":"Capital Markets","desc":"Fixed income covers debt securities — treasury bonds, corporate bonds, mortgage-backed securities, munis — that pay scheduled cash flows. Pricing reduces to discounting future coupons and principal at the right yield curve plus credit and prepayment spreads. It is the largest asset class globally (over 130 trillion USD","wiki":"https://en.wikipedia.org/wiki/Fixed_income"},{"id":"elem-QrO2ffoD","label":"Risk Management (VaR)","type":"Concept","category":"Quantitative Finance","desc":"Risk management measures, monitors and controls financial exposures across a firm's portfolios. Value at Risk (VaR) summarizes potential losses at a given confidence level over a given horizon. Banks use it to set capital requirements; funds use it to budget risk across strategies. Critics note VaR misses tail risk; ex","wiki":"https://en.wikipedia.org/wiki/Value_at_risk"},{"id":"elem-zhSbTWBN","label":"Risk Profile Assessment","type":"Notion","category":"Wealth Management","desc":"Risk profile assessment evaluates an investor's ability and willingness to bear investment risk. Considers horizon, liquidity needs, financial assets, behavioral tolerance and goals. Required by regulation (suitability rules) and used to set asset allocation and product eligibility. Often misjudged when risk-tolerance ","wiki":"https://en.wikipedia.org/wiki/Risk_aversion"},{"id":"elem-nfE5Dhhs","label":"Information Asymmetry","type":"Notion","category":"Market Efficiency","desc":"Information asymmetry exists when one party in a transaction knows more than the other. Drives adverse selection (lemons problem) and moral hazard, distorting market outcomes. Akerlof, Spence and Stiglitz won the Nobel for formalizing its consequences. Financial markets fight it through disclosure rules, ratings and si","wiki":"https://en.wikipedia.org/wiki/Information_asymmetry"},{"id":"elem-4Iwnho7Z","label":"Statistical Arbitrage","type":"Notion","category":"High-Frequency Trading (HFT)","desc":"Statistical arbitrage exploits mean-reverting price relationships across baskets of correlated securities. Pair trading is the simplest form; modern stat arb runs hundreds of factors across thousands of names. Renaissance, DE Shaw and Citadel built empires on stat arb in equities and futures. Edges decay rapidly as com","wiki":"https://en.wikipedia.org/wiki/Statistical_arbitrage"},{"id":"elem-joA1kcLE","label":"Efficient Market Hypothesis (EMH)","type":"Notion","category":"Market Efficiency","desc":"EMH states that asset prices fully reflect all available information at any time. Three forms: weak (prices reflect past prices), semi-strong (all public info), strong (all info including private). If true, beating the market consistently is impossible without insider information or extra risk. Behavioral finance and d","wiki":"https://en.wikipedia.org/wiki/Efficient-market_hypothesis"},{"id":"elem-w9HbLWj6","label":"Random Walk Theory","type":"Formula","category":"Market Efficiency","desc":"Random Walk theory says future price changes are unpredictable from past prices. Formal model: P_t = P_(t-1) + ε_t with random innovation. Closely tied to EMH — if prices reflect info instantly, changes are unforeseen news. Underpins technical analysis skepticism and Brownian motion modeling. It is a core conceptual pi","wiki":"https://en.wikipedia.org/wiki/Random_walk_hypothesis"},{"id":"elem-t9DI8rkq","label":"GARCH Models","type":"Formula","category":"Financial Econometrics","desc":"GARCH (Generalized AutoRegressive Conditional Heteroskedasticity) models time-varying volatility. Standard GARCH(1,1): σ²_t = ω + α × ε²_(t-1) + β × σ²_(t-1). Captures volatility clustering — calm periods follow calm, storms follow storms. Won Engle the Nobel and remains the standard volatility forecasting framework. I","wiki":"https://en.wikipedia.org/wiki/Autoregressive_conditional_heteroskedasticity"},{"id":"elem-WoRrqti5","label":"Ito's Lemma","type":"Formula","category":"Stochastic Calculus","desc":"Ito's Lemma is the chain rule for stochastic calculus — how functions of random processes evolve. Adds a second-derivative term to standard calculus due to non-zero variance of dW. Used to derive Black-Scholes, hedge derivatives and model continuous-time finance. Discovered by Kiyoshi Ito and indispensable to derivativ","wiki":"https://en.wikipedia.org/wiki/It%C3%B4%27s_lemma"},{"id":"elem-hwVxjUNI","label":"Dividend Payout Ratio","type":"Formula","category":"Dividend Policy","desc":"Payout ratio is the share of net income returned to shareholders as dividends. Formula: Payout = Dividends / Net Income. Mature firms pay 40-60 percent; growth firms keep most earnings to fund expansion. Sustained ratios above 100 percent are a red flag for cuts ahead. It is the simplest gauge of dividend sustainabilit","wiki":"https://en.wikipedia.org/wiki/Dividend_payout_ratio"},{"id":"elem-kgDLqUkt","label":"Black-Scholes Formula","type":"Formula","category":"Derivatives","desc":"Black-Scholes (1973) gave a closed-form price for European options under geometric Brownian motion. Formula: C = S × N(d1) - K × e^(-rT) × N(d2). Inputs: spot price, strike, rate, time to expiry, volatility. Won Nobel Prize and launched the modern derivatives industry. It is the single most influential equation in fina","wiki":"https://en.wikipedia.org/wiki/Black%E2%80%93Scholes_model"},{"id":"elem-MdTWMY6v","label":"Tactical Asset Allocation (TAA)","type":"Notion","category":"Asset Allocation","desc":"Tactical asset allocation tilts the portfolio away from strategic targets based on shorter-term views. Examples include overweighting equities in early-cycle expansions or shifting to cash before recessions. Adds value if forecasts are right; can destroy it if wrong (most market timing fails). Tactical bands typically ","wiki":"https://en.wikipedia.org/wiki/Tactical_asset_allocation"}],"links":[{"source":"elem-RT9qS8Jk","target":"elem-AQAF8YYX"},{"source":"elem-S96s2t7V","target":"elem-XQm37kzs"},{"source":"elem-eA9Xz4l3","target":"elem-XQm37kzs"},{"source":"elem-nN84scKt","target":"elem-gpWaiPsg"},{"source":"elem-T0vlJkIJ","target":"elem-GyggfXAj"},{"source":"elem-g40XNJaL","target":"elem-LQMraF5g"},{"source":"elem-Hg6JNgp7","target":"elem-0oLnKqjD"},{"source":"elem-T4GWiT1o","target":"elem-0oLnKqjD"},{"source":"elem-g854ZyLD","target":"elem-FsxWUqbk"},{"source":"elem-aC1zyduC","target":"elem-yQqThEU3"},{"source":"elem-oKCWJnFL","target":"elem-HJo7OOTv"},{"source":"elem-wI2G9YmP","target":"elem-7F0y6HPR"},{"source":"elem-2eRUMaAR","target":"elem-EzY2Zvc4"},{"source":"elem-ytcld5Wa","target":"elem-TCzMxDy2"},{"source":"elem-cN0jqmeB","target":"elem-GyggfXAj"},{"source":"elem-QhRflODD","target":"elem-LQMraF5g"},{"source":"elem-9rWqzsuW","target":"elem-wyrXZKOL"},{"source":"elem-OVH9liSd","target":"elem-WBDKAkva"},{"source":"elem-EzY2Zvc4","target":"elem-JYR5JEMA"},{"source":"elem-XXgNjBKF","target":"elem-EzY2Zvc4"},{"source":"elem-f7MY6sHQ","target":"elem-QhRflODD"},{"source":"elem-armErJ3f","target":"elem-TRgA3VHu"},{"source":"elem-HFXnZ6Cq","target":"elem-3kN6WCJA"},{"source":"elem-Ekaoz0oW","target":"elem-armErJ3f"},{"source":"elem-JYR5JEMA","target":"elem-RDzv8Gz5"},{"source":"elem-3c2SX8Fy","target":"elem-LQMraF5g"},{"source":"elem-MdTWMY6v","target":"elem-v3lPHpdW"},{"source":"elem-wyrXZKOL","target":"elem-mdabgZpI"},{"source":"elem-Aei4qvE3","target":"elem-gpWaiPsg"},{"source":"elem-5OxINPqg","target":"elem-7F0y6HPR"},{"source":"elem-8lItpWyE","target":"elem-B5qSPYrV"},{"source":"elem-O2SkhkMj","target":"elem-CF5BrdoZ"},{"source":"elem-6qIxom1X","target":"elem-sXaCKPy5"},{"source":"elem-6izcf0KY","target":"elem-JYR5JEMA"},{"source":"elem-FHJgvIj2","target":"elem-unteIuf3"},{"source":"elem-VHvr34wX","target":"elem-QrO2ffoD"},{"source":"elem-kdMtmnuI","target":"elem-QhRflODD"},{"source":"elem-6YHO5p1p","target":"elem-l3ayOhRi"},{"source":"elem-hO0KYapB","target":"elem-XQm37kzs"},{"source":"elem-rLKw7Hbz","target":"elem-EzY2Zvc4"},{"source":"elem-xfscazqV","target":"elem-B5qSPYrV"},{"source":"elem-eL8NSwhC","target":"elem-JYR5JEMA"},{"source":"elem-DumlCZL9","target":"elem-4XkZI0sg"},{"source":"elem-5Fk3thkn","target":"elem-LQMraF5g"},{"source":"elem-w9HbLWj6","target":"elem-6izcf0KY"},{"source":"elem-Uboc7mVr","target":"elem-3wAPefFF"},{"source":"elem-HhuIRX68","target":"elem-FsxWUqbk"},{"source":"elem-mdabgZpI","target":"elem-RDzv8Gz5"},{"source":"elem-joA1kcLE","target":"elem-6izcf0KY"},{"source":"elem-cDgE9hLM","target":"elem-WBDKAkva"},{"source":"elem-MYTNQty7","target":"elem-v3lPHpdW"},{"source":"elem-Rp4DZrw9","target":"elem-JYR5JEMA"},{"source":"elem-TCzMxDy2","target":"elem-JYR5JEMA"},{"source":"elem-nJPLbZhC","target":"elem-AQAF8YYX"},{"source":"elem-KdSsKmA2","target":"elem-3Tjovyd3"},{"source":"elem-N1vPS4IR","target":"elem-5Fk3thkn"},{"source":"elem-kgDLqUkt","target":"elem-TCzMxDy2"},{"source":"elem-Wk9wjiQB","target":"elem-g40XNJaL"},{"source":"elem-9gxtstWR","target":"elem-7OQi9Ge1"},{"source":"elem-WxsY8Kmz","target":"elem-Rp4DZrw9"},{"source":"elem-WBDKAkva","target":"elem-TRgA3VHu"},{"source":"elem-Lt6t4zt6","target":"elem-QhRflODD"},{"source":"elem-4ew6h9aB","target":"elem-HJo7OOTv"},{"source":"elem-bjyZa6Yj","target":"elem-QrO2ffoD"},{"source":"elem-3PuEdNCf","target":"elem-7OQi9Ge1"},{"source":"elem-gb198Jjy","target":"elem-yQqThEU3"},{"source":"elem-eJOblP25","target":"elem-bcvAONXx"},{"source":"elem-cGetkC1q","target":"elem-unteIuf3"},{"source":"elem-c7KUwGyl","target":"elem-CF5BrdoZ"},{"source":"elem-niR8KQpw","target":"elem-3c2SX8Fy"},{"source":"elem-ovothnRA","target":"elem-wyrXZKOL"},{"source":"elem-3Tjovyd3","target":"elem-mdabgZpI"},{"source":"elem-5lMZsV1u","target":"elem-CF5BrdoZ"},{"source":"elem-ZtmyaSYE","target":"elem-I8RAeCXe"},{"source":"elem-3kN6WCJA","target":"elem-TRgA3VHu"},{"source":"elem-5WzwucPc","target":"elem-3kN6WCJA"},{"source":"elem-ZriX6cyt","target":"elem-JYR5JEMA"},{"source":"elem-FgZlOSZJ","target":"elem-FsxWUqbk"},{"source":"elem-TRgA3VHu","target":"elem-RDzv8Gz5"},{"source":"elem-4Iwnho7Z","target":"elem-Rp4DZrw9"},{"source":"elem-aXZA42mU","target":"elem-TCzMxDy2"},{"source":"elem-LQMraF5g","target":"elem-RDzv8Gz5"},{"source":"elem-XeWN0mA5","target":"elem-l3ayOhRi"},{"source":"elem-7CBOgnoZ","target":"elem-g40XNJaL"},{"source":"elem-QrO2ffoD","target":"elem-LQMraF5g"},{"source":"elem-PCps0Age","target":"elem-Rp4DZrw9"},{"source":"elem-nW4eYSC6","target":"elem-3Tjovyd3"},{"source":"elem-w5Yzn40O","target":"elem-gpWaiPsg"},{"source":"elem-7OQi9Ge1","target":"elem-JYR5JEMA"},{"source":"elem-vqvk59Bp","target":"elem-Cwd14Vyn"},{"source":"elem-FZ1yrZh7","target":"elem-Co4Z70HG"},{"source":"elem-HtoKqf4p","target":"elem-sXaCKPy5"},{"source":"elem-ZtH4JIHh","target":"elem-eL8NSwhC"},{"source":"elem-v3lPHpdW","target":"elem-mdabgZpI"},{"source":"elem-SFO4uRug","target":"elem-3Tjovyd3"},{"source":"elem-B5qSPYrV","target":"elem-LQMraF5g"},{"source":"elem-CF5BrdoZ","target":"elem-mdabgZpI"},{"source":"elem-ew8aeGCg","target":"elem-I8RAeCXe"},{"source":"elem-unteIuf3","target":"elem-TRgA3VHu"},{"source":"elem-bs97ftCC","target":"elem-g40XNJaL"},{"source":"elem-Oo7SaJnk","target":"elem-v2aEXB2T"},{"source":"elem-KwZQKutm","target":"elem-v3lPHpdW"},{"source":"elem-QCwCIefv","target":"elem-3c2SX8Fy"},{"source":"elem-wGHMgy8R","target":"elem-l3ayOhRi"},{"source":"elem-v2aEXB2T","target":"elem-TRgA3VHu"},{"source":"elem-n5u1nLg4","target":"elem-0oLnKqjD"},{"source":"elem-qyjfI7Ql","target":"elem-4XkZI0sg"},{"source":"elem-HB93mRbf","target":"elem-WuqYmq0o"},{"source":"elem-t9DI8rkq","target":"elem-4XkZI0sg"},{"source":"elem-qOZ26BG1","target":"elem-QrO2ffoD"},{"source":"elem-HAy8YAhG","target":"elem-7F0y6HPR"},{"source":"elem-K3E5ONjq","target":"elem-unteIuf3"},{"source":"elem-ZC7rydUV","target":"elem-WuqYmq0o"},{"source":"elem-Co4Z70HG","target":"elem-mdabgZpI"},{"source":"elem-NfZggdbM","target":"elem-WBDKAkva"},{"source":"elem-4dLWw5wR","target":"elem-v2aEXB2T"},{"source":"elem-ANFOQCIc","target":"elem-armErJ3f"},{"source":"elem-l3ayOhRi","target":"elem-JYR5JEMA"},{"source":"elem-XEMruMM5","target":"elem-ZriX6cyt"},{"source":"elem-U9FC3B7i","target":"elem-HJo7OOTv"},{"source":"elem-SH588GBT","target":"elem-armErJ3f"},{"source":"elem-ZYReqiDW","target":"elem-Co4Z70HG"},{"source":"elem-3wAPefFF","target":"elem-mdabgZpI"},{"source":"elem-gewvfl4d","target":"elem-5Fk3thkn"},{"source":"elem-IRugKpsy","target":"elem-3wAPefFF"},{"source":"elem-sXaCKPy5","target":"elem-TRgA3VHu"},{"source":"elem-aXMMP417","target":"elem-eL8NSwhC"},{"source":"elem-Cwd14Vyn","target":"elem-JYR5JEMA"},{"source":"elem-05MLrCA6","target":"elem-ZriX6cyt"},{"source":"elem-db5yrCwE","target":"elem-B5qSPYrV"},{"source":"elem-7F0y6HPR","target":"elem-TRgA3VHu"},{"source":"elem-3Gr5Be4r","target":"elem-v2aEXB2T"},{"source":"elem-4XkZI0sg","target":"elem-LQMraF5g"},{"source":"elem-nfE5Dhhs","target":"elem-6izcf0KY"},{"source":"elem-WoRrqti5","target":"elem-5Fk3thkn"},{"source":"elem-6Rwnbd7V","target":"elem-3wAPefFF"},{"source":"elem-Cz9KXEgp","target":"elem-eL8NSwhC"},{"source":"elem-FsxWUqbk","target":"elem-mdabgZpI"},{"source":"elem-SzkWwN16","target":"elem-sXaCKPy5"},{"source":"elem-zhSbTWBN","target":"elem-Co4Z70HG"},{"source":"elem-aoeVlZpJ","target":"elem-3kN6WCJA"},{"source":"elem-NYV4iY5N","target":"elem-GyggfXAj"},{"source":"elem-yzEk31ah","target":"elem-AQAF8YYX"},{"source":"elem-HJo7OOTv","target":"elem-LQMraF5g"},{"source":"elem-sAfXrvm2","target":"elem-yQqThEU3"},{"source":"elem-WuqYmq0o","target":"elem-TRgA3VHu"},{"source":"elem-7tJCAkq7","target":"elem-bcvAONXx"},{"source":"elem-I8RAeCXe","target":"elem-TRgA3VHu"},{"source":"elem-kzQmdnfo","target":"elem-7OQi9Ge1"},{"source":"elem-gqSl7rsY","target":"elem-bcvAONXx"},{"source":"elem-lKiHeRSa","target":"elem-Cwd14Vyn"},{"source":"elem-0oLnKqjD","target":"elem-mdabgZpI"},{"source":"elem-db5OFtCc","target":"elem-ZriX6cyt"},{"source":"elem-GyggfXAj","target":"elem-mdabgZpI"},{"source":"elem-AQAF8YYX","target":"elem-JYR5JEMA"},{"source":"elem-yQqThEU3","target":"elem-mdabgZpI"},{"source":"elem-wf8cLsmF","target":"elem-3c2SX8Fy"},{"source":"elem-XQm37kzs","target":"elem-TRgA3VHu"},{"source":"elem-bcvAONXx","target":"elem-LQMraF5g"},{"source":"elem-xzqPZ0wX","target":"elem-Cwd14Vyn"},{"source":"elem-ifElI83j","target":"elem-wyrXZKOL"},{"source":"elem-xvMSjYmM","target":"elem-WuqYmq0o"},{"source":"elem-gpWaiPsg","target":"elem-LQMraF5g"},{"source":"elem-hwVxjUNI","target":"elem-I8RAeCXe"}]};

var svgEl = document.getElementById('mm-svg');
var wrap  = document.getElementById('mm-wrap');
var tipEl = document.getElementById('mm-tip');

var W = wrap.clientWidth || 820;
var H = 540;
svgEl.style.height = H + 'px';

// ── Colours & sizes ─────────────────────────────────────────
var COL = {Root:'#1A0800', Category:'#5A3D1A', Concept:'#7B2D2D', Formula:'#7A5C1A', Notion:'#3D5C35'};
function nodeColor(d) { return COL[d.type] || '#999'; }
function nodeR(d) {
  if(d.type==='Root')     return 18;
  if(d.type==='Category') return 11;
  return 5.75;
}
function truncLabel(s, n) { return s.length > n ? s.slice(0,n)+'\u2026' : s; }

// ── SVG + zoom ───────────────────────────────────────────────
var svg = d3.select('#mm-svg').attr('width','100%').attr('height',H);
var g   = svg.append('g');

var zoomBeh = d3.zoom()
  .scaleExtent([0.1, 10])
  .on('zoom', function(ev) { g.attr('transform', ev.transform); });
svg.call(zoomBeh).on('dblclick.zoom', null);

window.mmZoom = function(k) { svg.transition().duration(300).call(zoomBeh.scaleBy, k); };
window.mmFit  = function() {
  var b = g.node().getBBox();
  if(!b.width) return;
  var pad = 48;
  var sc  = Math.min((W-pad*2)/b.width, (H-pad*2)/b.height, 1.6);
  var tx  = W/2 - sc*(b.x + b.width/2);
  var ty  = H/2 - sc*(b.y + b.height/2);
  svg.transition().duration(600).call(zoomBeh.transform, d3.zoomIdentity.translate(tx,ty).scale(sc));
};

svg.on('mousedown', function() { svgEl.style.cursor='grabbing'; });
svg.on('mouseup',   function() { svgEl.style.cursor='grab'; });

// ── Data clone ───────────────────────────────────────────────
var nodes = MMGRAPH.nodes.map(function(n) { return Object.assign({}, n); });
var links = MMGRAPH.links.map(function(l) { return {source:l.source, target:l.target}; });

// ── Pre-position nodes so they start spread out ──────────────
(function() {
  var root = null, cats = [], catMap = {};
  nodes.forEach(function(n) {
    if(n.type==='Root') root = n;
    else if(n.type==='Category') cats.push(n);
  });
  if(root) { root.x = W/2; root.y = H/2; }
  cats.forEach(function(c, i) {
    var angle = (i / cats.length) * 2 * Math.PI - Math.PI/2;
    c.x = W/2 + Math.cos(angle) * 160;
    c.y = H/2 + Math.sin(angle) * 160;
    catMap[c.label] = {x: c.x, y: c.y};
  });
  nodes.forEach(function(n) {
    if(n.type==='Root' || n.type==='Category') return;
    var cp = catMap[n.category] || {x: W/2, y: H/2};
    var angle = Math.random() * 2 * Math.PI;
    var r = 60 + Math.random() * 110;
    n.x = cp.x + Math.cos(angle) * r;
    n.y = cp.y + Math.sin(angle) * r;
  });
})();

// ── Simulation ───────────────────────────────────────────────
var sim = d3.forceSimulation(nodes)
  .force('link', d3.forceLink(links)
    .id(function(d) { return d.id; })
    .distance(function(l) {
      var st = l.source.type || '', tt = l.target.type || '';
      if(st==='Root'     || tt==='Root')     return 78;   // tighter to centre
      if(st==='Category' || tt==='Category') return 72;
      return 44;
    })
    .strength(0.85)
  )
  .force('charge', d3.forceManyBody().strength(function(d) {
    if(d.type==='Root')     return -1400;
    if(d.type==='Category') return -550;
    return -220;
  }))
  .force('center', d3.forceCenter(W/2, H/2))
  .force('collide', d3.forceCollide().radius(function(d) { return nodeR(d)+22; }).iterations(4))
  .alphaDecay(0.022);

// ── Curved links ─────────────────────────────────────────────
function arcPath(d) {
  var sx = d.source.x, sy = d.source.y;
  var tx = d.target.x, ty = d.target.y;
  var mx = (sx+tx)/2, my = (sy+ty)/2;
  var dx = tx-sx, dy = ty-sy;
  var len = Math.sqrt(dx*dx+dy*dy) || 1;
  var sign = d.source.id > d.target.id ? 1 : -1;
  var k = 0.13;
  var cpx = mx + sign*(dy/len)*len*k;
  var cpy = my - sign*(dx/len)*len*k;
  return 'M'+sx+','+sy+' Q'+cpx+','+cpy+' '+tx+','+ty;
}

var linkSel = g.append('g')
  .selectAll('path').data(links).join('path')
  .attr('fill', 'none')
  .attr('stroke', 'rgba(90,60,30,0.16)')
  .attr('stroke-width', 1);

// ── Nodes ────────────────────────────────────────────────────
var nodeSel = g.append('g')
  .selectAll('circle').data(nodes).join('circle')
  .attr('r', nodeR)
  .attr('fill', nodeColor)
  .attr('opacity', function(d) { return d.type==='Root'?1 : d.type==='Category'?0.92 : 0.75; })
  .attr('stroke', function(d) { return (d.type==='Root'||d.type==='Category') ? 'rgba(255,255,255,0.25)' : 'none'; })
  .attr('stroke-width', 1.5)
  .style('cursor', 'pointer')
  .call(d3.drag()
    .on('start', function(ev,d) {
      if(!ev.active) sim.alphaTarget(0.3).restart();
      d.fx=d.x; d.fy=d.y; svgEl.style.cursor='grabbing';
    })
    .on('drag',  function(ev,d) { d.fx=ev.x; d.fy=ev.y; })
    .on('end',   function(ev,d) {
      if(!ev.active) sim.alphaTarget(0);
      d.fx=null; d.fy=null; svgEl.style.cursor='grab';
    })
  )
  .on('click', function(ev, d) {
    ev.stopPropagation();
    pinTip(ev, d);
  })
  .on('mouseover', function(ev, d) {
    d3.select(this)
      .attr('stroke', 'rgba(255,255,255,0.85)').attr('stroke-width', 2.5)
      .attr('r', function(dd) { return nodeR(dd)+2; });
    cancelHide();
    showHoverTip(ev, d);
  })
  .on('mousemove', function(ev) { if(!_pinned) posTip(ev); })
  .on('mouseout', function(ev, d) {
    d3.select(this)
      .attr('stroke', function(dd) { return (dd.type==='Root'||dd.type==='Category') ? 'rgba(255,255,255,0.25)' : 'none'; })
      .attr('stroke-width', 1.5)
      .attr('r', nodeR);
    startHide();
  });

// ── Labels — ALL nodes ───────────────────────────────────────
var labelSel = g.append('g')
  .selectAll('text').data(nodes).join('text')
  .text(function(d) {
    if(d.type==='Root')     return d.label;
    if(d.type==='Category') return d.label;
    return truncLabel(d.label, 18);
  })
  .attr('font-family', 'Georgia, serif')
  .attr('font-size', function(d) {
    if(d.type==='Root')     return 12;
    if(d.type==='Category') return 9;
    return 6.5;
  })
  .attr('fill', function(d) {
    if(d.type==='Root')     return '#1A0800';
    if(d.type==='Category') return '#5A3D1A';
    return nodeColor(d);
  })
  .attr('font-weight', function(d) { return d.type==='Root' ? '700' : '400'; })
  .attr('opacity', function(d) { return (d.type==='Root'||d.type==='Category') ? 1 : 0.75; })
  .attr('text-anchor', 'middle')
  .attr('dy', function(d) { return -(nodeR(d)+4); })
  .attr('pointer-events', 'none');

// ── Tick ─────────────────────────────────────────────────────
sim.on('tick', function() {
  linkSel.attr('d', arcPath);
  nodeSel.attr('cx', function(d) { return d.x; }).attr('cy', function(d) { return d.y; });
  labelSel.attr('x', function(d) { return d.x; }).attr('y', function(d) { return d.y; });
});

var _initialFitDone = false;
sim.on('end', function() {
  if(!_initialFitDone) { _initialFitDone = true; setTimeout(mmFit, 10000); }
});

// ── Tooltip logic ─────────────────────────────────────────────
var _pinned = false;
var _tipTimer;

function buildTip(d) {
  while(tipEl.firstChild) tipEl.removeChild(tipEl.firstChild);

  var closeBtn = mk('button','mm-tip-close');
  closeBtn.textContent = '\xd7';
  closeBtn.addEventListener('click', function(e){ e.stopPropagation(); unpinTip(); });
  tipEl.appendChild(closeBtn);

  var typeDiv = mk('div','mm-tip-type');
  typeDiv.textContent = d.type;
  tipEl.appendChild(typeDiv);

  var labelDiv = mk('div','mm-tip-label');
  labelDiv.textContent = d.label;
  tipEl.appendChild(labelDiv);

  if(d.desc){
    var descDiv = mk('div','mm-tip-desc');
    descDiv.textContent = d.desc.slice(0,300) + (d.desc.length>300 ? '\u2026' : '');
    tipEl.appendChild(descDiv);
  }

  if(d.wiki){
    var wikiA = document.createElement('a');
    wikiA.className = 'mm-tip-wiki';
    wikiA.textContent = 'Read more \u2197';
    wikiA.href = d.wiki;
    wikiA.target = '_blank';
    wikiA.rel = 'noopener noreferrer';
    tipEl.appendChild(wikiA);
  }
}

function showHoverTip(ev, d) {
  if(_pinned) return;
  buildTip(d);
  tipEl.classList.remove('mm-tip-pinned');
  tipEl.style.display = 'block';
  posTip(ev);
}

function pinTip(ev, d) {
  _pinned = true;
  clearTimeout(_tipTimer);
  buildTip(d);
  tipEl.classList.add('mm-tip-pinned');
  tipEl.style.display = 'block';
  posTip(ev);
}

function unpinTip() {
  _pinned = false;
  tipEl.style.display = 'none';
  tipEl.classList.remove('mm-tip-pinned');
}

function posTip(ev) {
  var r = wrap.getBoundingClientRect();
  var x = ev.clientX - r.left + 16;
  var y = ev.clientY - r.top  - 16;
  if(x + 260 > r.width)  x = ev.clientX - r.left - 276;
  if(y + tipEl.offsetHeight > r.height) y = ev.clientY - r.top - tipEl.offsetHeight - 8;
  if(y < 0) y = 8;
  tipEl.style.left = x + 'px';
  tipEl.style.top  = y + 'px';
}

function startHide() {
  if(_pinned) return;
  _tipTimer = setTimeout(function(){ if(!_pinned) tipEl.style.display='none'; }, 1400);
}

function cancelHide() { clearTimeout(_tipTimer); }

tipEl.addEventListener('mouseenter', cancelHide);
tipEl.addEventListener('mouseleave', function(){ if(!_pinned) tipEl.style.display='none'; });

// Click outside SVG to unpin
wrap.addEventListener('click', function(ev){
  if(!tipEl.contains(ev.target) && !ev.target.closest('circle')) unpinTip();
});

function mk(tag, cls){ var el=document.createElement(tag); if(cls) el.className=cls; return el; }

// ── Resize ───────────────────────────────────────────────────
window.addEventListener('resize', function() {
  W = wrap.clientWidth || W;
  sim.force('center', d3.forceCenter(W/2, H/2)).alpha(0.1).restart();
});

})();
        </script>

      </div>
    </div>
  </div>

  <!-- ─── 01 · DASHBOARD — chocolat ────────────────────────── -->
  <div class="sec-band sec-choc">
    <div class="section-lbl" id="learn-dashboard">
      
      <h2>Dashboard</h2><em>How to Read the Engine Room</em>
    </div>
    <div class="lrn-wrap">

      <!-- ── Sidebar chips — ordered to match dashboard ── -->
      <nav class="lrn-toc" aria-label="Dashboard sections">
        <div class="lrn-toc-label">Dashboard</div>
        <button class="lrn-toc-link lrn-toc-overview" data-tab="overview">
          <span class="lrn-toc-num">↳</span>Overview
        </button>
        <button class="lrn-toc-link" data-tab="tips">
          <span class="lrn-toc-num">→</span>Tips &amp; Tricks
        </button>
